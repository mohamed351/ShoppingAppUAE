@model ShoppingAppUAE.Models.CheckoutViewModels.CheckOutViewModel
@{
    ViewData["Title"] = "Index";
}

@section styles{
    <script src="https://js.stripe.com/v3/"></script>
    <link href="~/template-user/all/loading.css" rel="stylesheet" />

    <style>
        .qtybutton {
            cursor: pointer;
        }

        .shipping-cart-item {
            list-style: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-left: 0px;
        }

        .card-shipping {
            border: 1px solid #eee;
            padding: 10px;
        }

        .loading-bar {
            background: rgba(200, 200, 200, 0.75);
            color: #fff;
            height: 100vh;
            width: 100vw;
            position: fixed;
            z-index: 999999;
            top: 0%;
            left: 0%;
            display: flex;
            justify-content: center;
            align-items: center;
        }
    </style>


}

<div style="display:none" class="loading-bar">
    <div  class="loadingio-spinner-spinner-g5gku4jwumr">
        <div class="lds-spinner"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>
    </div>
</div>

<!-- BREADCRUMB AREA START -->
<div class="ltn__breadcrumb-area ltn__breadcrumb-area-4 ltn__breadcrumb-color-white---">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="ltn__page-title">Checkout</h1>
                    <div class="ltn__breadcrumb-list">
                        <ul>
                            <li><a asp-action="Index" asp-controller="Home">Home</a></li>
                            <li>Checkout</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- WISHLIST AREA START -->
<form id="payment-form" asp-controller="Checkout" asp-action="SubmitCheckout" method="post">
    <div class="ltn__checkout-area mb-100">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="ltn__checkout-inner">

                        <div class="ltn__checkout-single-content mt-50">
                            <h4 class="title-2">Billing Details</h4>
                            <div class="ltn__checkout-single-content-info">

                                <h6>Personal Information</h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="input-item input-item-name ltn__custom-icon">
                                            <input readonly asp-for="ApplicationUser.FirstName" placeholder="First name">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-item input-item-name ltn__custom-icon">
                                            <input readonly asp-for="ApplicationUser.LastName" placeholder="Last name">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-item input-item-email ltn__custom-icon">
                                            <input asp-for="ApplicationUser.Email" placeholder="email address">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-item input-item-phone ltn__custom-icon">
                                            <input type="text" readonly asp-for="ApplicationUser.PhoneNumber" value="@Model.ApplicationUser.PhonePrefix @Model.ApplicationUser.PhoneNumber " placeholder="phone number">
                                        </div>
                                    </div>


                                </div>
                                <div class="row">

                                    <div class="col-lg-12 col-md-12">
                                        <h6>Address</h6>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="input-item">
                                                    <input type="text" asp-for="ApplicationUser.Address">
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-6">
                                        <h6>Town / City</h6>
                                        <div class="input-item">
                                            <input type="text" placeholder="City" asp-for="ApplicationUser.City">
                                        </div>
                                    </div>


                                </div>

                                <h6>Order Notes (optional)</h6>
                                <div class="input-item input-item-textarea ltn__custom-icon">
                                    <textarea asp-for="Note" placeholder="Notes about your order, e.g. special notes for delivery."></textarea>
                                </div>


                            </div>
                        </div>
                    </div>



                </div>



                <div class="col-lg-12">
                    <h2>Shipping</h2>
                    @foreach (var item in Model.ShippingDetails)
                    {
                        <ul>
                            <li class="shipping-cart-item card-shipping">
                                <input type="radio" class="shipping-cart-item-radio"
                                       name="shippingPirce" data-id="@item.ID"
                                       data-price="@item.ShippingPrice"
                                       data-weight-limit="@item.FirstWeightLimit"
                                       data-price-afterExisting="@item.PriceAfterExcedingTheLimit"
                                       data-weight-afterExisting="@item.AdditionalKgAfterExcedingTheLimit"
                                       data-isDefault="@item.IsDefault" />  <span>@item.ShippingCompany</span>
                                </li>
                            </ul>
                        }

                </div>

                <div class="col-lg-6">
                    <div class="ltn__checkout-payment-method mt-50">
                        <h4 class="title-2">Payment Method</h4>
                        <div id="checkout_accordion_1">

                            <div class="card">
                                <h5 class="ltn__card-title" data-toggle="collapse" data-target="#faq-item-2-2" aria-expanded="true">
                                    Cash on delivery
                                </h5>
                                <div id="faq-item-2-2" data-id="0" class="collapse show" data-parent="#checkout_accordion_1">
                                    <div class="card-body">
                                        <p>Pay with cash upon delivery.</p>
                                    </div>
                                </div>
                            </div>
                            <!-- card -->
                            <div class="card">
                                <h5 class="collapsed ltn__card-title" data-id="1" data-toggle="collapse" data-target="#faq-item-2-3" aria-expanded="false">
                                    Card Debit /Credit
                                </h5>
                                <div id="faq-item-2-3" data-id="1" class="collapse" data-parent="#checkout_accordion_1">
                                    <div class="card-body" id="payment-element">

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="ltn__payment-note mt-30 mb-30">
                            <p>Your personal data will be used to process your order, support your experience throughout this website, and for other purposes described in our privacy policy.</p>
                        </div>
                        <button class="btn theme-btn-1 btn-effect-1 text-uppercase" id="submit" type="submit">Place order</button>
                    </div>
                </div>





                <div class="col-lg-6">
                    <div class="shoping-cart-total mt-50">
                        <h4 class="title-2">Cart Totals</h4>
                        <table class="table">
                            <tbody id="payment-details">
                                @*<tr>
                                        <td>Brake Conversion Kit <strong>× 2</strong></td>
                                        <td>$298.00</td>
                                    </tr>
                                    <tr>
                                        <td>OE Replica Wheels <strong>× 2</strong></td>
                                        <td>$170.00</td>
                                    </tr>
                                    <tr>
                                        <td>Wheel Bearing Retainer <strong>× 2</strong></td>
                                        <td>$150.00</td>
                                    </tr>
                                    <tr>
                                        <td>Shipping and Handing</td>
                                        <td>$15.00</td>
                                    </tr>
                                    <tr>
                                        <td>Vat</td>
                                        <td>$00.00</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Order Total</strong></td>
                                        <td><strong>$633.00</strong></td>
                                    </tr>*@


                            </tbody>
                        </table>

                        <table class="table">
                            <tbody>
                                <tr>
                                    <td>
                                        Shipping
                                    </td>
                                    <td id="shippingPirce">
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


</form>


@inject IConfiguration configuration
@inject IViewLocalizer locaization
<!DOCTYPE html>
<html lang="@(CultureInfo.CurrentCulture.Name.Contains("ar") ?"ar":"en" )">

<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title> Shopping Application - @ViewData["Title"] </title>

    @RenderSection("metaTags", false)

    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="shortcut icon" href="~/favicon.ico" type="image/x-icon" />
    @if (CultureInfo.CurrentCulture.Name.Contains("ar"))
    {
        <link href="~/template-user/rtl/css/arabic-plugin-bundle.rtl.min.css" rel="stylesheet" />
        <link href="~/template-user/rtl/css/arabic-style-bundle.rtl.min.css" rel="stylesheet" />

    }
    else
    {

        <link href="~/template-user/ltr/css/english-plugin-bundle.ltr.min.css" rel="stylesheet" />
        <link href="~/template-user/ltr/css/english-style-bundle.ltr.min.css" rel="stylesheet" />


    }

<link href="~/lib/alertifyjs/css/alertify.min.css" rel="stylesheet" />
    <style>
        html {
            overflow-x: hidden !important;
        }
    </style>
    <link href="~/css/icons/font-awesome/css/fontawesome.min.css" rel="stylesheet" />
    @RenderSection("styles", false)
    <style>
        .setting-top-bar {
            background-color: #FCFCFC;
            overflow-y: visible;
            padding: 0 10px;
        }

        .nice-select {
            z-index: 9999;
        }

        .icon-size {
            font-size: 25px;
            padding: 0 10px;
        }

        .ltn__utilize-cart-menu {
            z-index: 99999;
        }
    </style>
</head>

<body>

    <section class="d-flex justify-content-end setting-top-bar">

        <form asp-action="Cookie" asp-area="" asp-controller="Home" method="post" class="d-flex align-items-center">

            <i class="fa fa-globe icon-size"></i>
            <input type="hidden" id="language-app-hidden" value="@CultureInfo.CurrentCulture.Name" />
            <select name="culture" id="language-app">

                <option value="ar-EG">العربية </option>
                <option value="en-GB">English </option>
            </select>


            <i class="fa  fa-money-bill-alt icon-size"></i>
            <select>
                <option value="AED"> AED</option>
                <option value="USD"> USD</option>
            </select>

        </form>
    </section>

    <input type="hidden" id="GlobalCurrencyCode" value="@configuration["CompanyInfo:DefaultCurrency"]" />
    <main class="body-wrapper">


        <header class="ltn__header-area ltn__header-3 section-bg-6">

            <section class="ltn__header-middle-area">
                <section class="container">
                    <section class="row">
                        <section class="col">
                            <div class="site-logo">
                                <a asp-action="Index" asp-controller="Home" asp-area=""><img src="~/template-user/ltr/img/logo.png" alt="Logo"></a>
                            </div>
                        </section>
                        <section class="col header-contact-serarch-column d-none d-xl-block">
                            <div class="header-contact-search">

                                <section class="header-feature-item">
                                    <section class="header-feature-icon">
                                        <i class="icon-phone"></i>
                                    </section>
                                    <article class="header-feature-info">
                                        <h6>@locaization["Phone"]</h6>
                                        <p><a href="tel:0123456789">+0123-456-789</a></p>
                                    </article>
                                </section>
                                <!-- header-search-2 -->
                                <section class="header-search-2">
                                    <form  method="get" asp-action="Search" asp-controller="Product" asp-area="" >
                                        <input type="text" id="txtSearch" name="search"  autocomplete="off" value="" placeholder="@locaization["Seachhere"] ..." />
                                        <button type="submit">
                                            <span><i class="icon-magnifier"></i></span>
                                        </button>
                                    </form>
                                </section>
                            </div>
                        </section>
                        <section class="col">
                            <section class="ltn__header-options">
                                <ul>

                                    <li class="d-none">
                                        <!-- header-search-1 -->
                                        <section class="header-search-wrap">
                                            <section class="header-search-1">
                                                <section class="search-icon">
                                                    <i class="icon-magnifier  for-search-show"></i>
                                                    <i class="icon-magnifier-remove  for-search-close"></i>
                                                </section>
                                            </section>
                                            <section class="header-search-1-form">
                                                <form id="#" method="get" action="#">
                                                    <input type="text" id="txtSearchPhone" name="search" autocomplete="off" value="" placeholder="@locaization["Seachhere"] ..." />
                                                    <button type="submit">
                                                        <span><i class="icon-magnifier"></i></span>
                                                    </button>
                                                </form>
                                            </section>
                                        </section>
                                    </li>


                                    <li>
                                        <!-- user-menu -->
                                        <section class="ltn__drop-menu user-menu">
                                            <ul>
                                                <li>
                                                    <a href="#"><i class="icon-user"></i></a>
                                                    <ul>

                                                        @if (!User.Identity.IsAuthenticated)
                                                        {
                                                            <li><a asp-action="Login" asp-area="Identity" asp-controller="Account">@locaization["SignIn"]</a></li>
                                                            <li><a asp-action="Register" asp-area="Identity" asp-controller="Account">@locaization["Register"]</a></li>

                                                        }
                                                        @if (User.Identity.IsAuthenticated)
                                                        {
                                                            <li><a asp-action="Index" asp-controller="Account" asp-area="">@locaization["MyAccount"]</a></li>
                                                            <li><a asp-action="Index" asp-controller="WishList" asp-area="">@locaization["Wishlist"]</a></li>
                                                      
                                                            <li>
                                                            <li>
                                                                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                                                    <button type="submit" class="nav-link btn btn-link text-dark">@locaization["Logout"]</button>
                                                                </form>
                                                            </li>
</li>

                                                }
                                                    </ul>


                                                </section>


                                            </li>

                                            <li>
                                              
                                                <section class="mini-cart-icon mini-cart-icon-2">
                                                    <a href="#ltn__utilize-cart-menu" class="ltn__utilize-toggle">
                                                        <span class="mini-cart-icon">
                                                            <i class="icon-handbag"></i>
                                                            <sup id="totalCount">0</sup>
                                                        </span>

                                                    </a>
                                                </section>



                                            </li>






                                            <li>
                                                <!-- Mobile Menu Button -->
                                                <section class="mobile-menu-toggle d-lg-none">
                                                    <a href="#ltn__utilize-mobile-menu" class="ltn__utilize-toggle">
                                                        <svg viewBox="0 0 800 600">
                                                            <path d="M300,220 C300,220 520,220 540,220 C740,220 640,540 520,420 C440,340 300,200 300,200" id="top"></path>
                                                            <path d="M300,320 L540,320" id="middle"></path>
                                                            <path d="M300,210 C300,210 520,210 540,210 C740,210 640,530 520,410 C440,330 300,190 300,190" id="bottom" transform="translate(480, 320) scale(1, -1) translate(-480, -318) "></path>
                                                        </svg>
                                                    </a>
                                                </section>
                                            </li>
                                        </ul>
                                    </section>
                                </section>
                            </section>
                        </section>

                    </section>
                    <section class="header-bottom-area ltn__border-top ltn__header-sticky  ltn__sticky-bg-white ltn__primary-bg---- menu-color-white---- d-none d-lg-block">
                        <section class="container">
                            <section class="row">
                                <section class="col header-menu-column justify-content-center">
                                    <section class="sticky-logo">
                                        <div class="site-logo">
                                            <a asp-area="" asp-action="Index" title="Home" asp-controller="Home"><img src="~/template-user/ltr/img/logo.png" alt="Logo"></a>
                                        </div>
                                    </section>
                                    <section class="header-menu header-menu-2">
                                        <nav>
                                            <section class="ltn__main-menu">
                                                <ul>
                                                    <li>
                                                        <a asp-area="" title="Home" asp-action="Index" asp-controller="Home">@locaization["Home"]</a>

                                                    </li>
                                                    <li>
                                                        <a asp-area="" title="Products" asp-action="Index" asp-controller="Product">@locaization["Products"]</a>
                                                    </li>

                                                    <li><a asp-area="" title="Contact" asp-action="Index" asp-controller="Contact">@locaization["Contact"]</a></li>

                                                    <li><a asp-area="" title="About" asp-action="Index" asp-controller="AboutUs">@locaization["About"]</a></li>

                                                    <li><a asp-action="Index" asp-controller="News" asp-area="">@locaization["News"]</a></li>
                                                </ul>
                                            </section>
                                        </nav>
                                    </section>
                                </section>
                            </section>
                        </section>
                    </section>
                    <!-- header-bottom-area end -->
                </header>

                <section id="ltn__utilize-cart-menu" class="ltn__utilize ltn__utilize-cart-menu">
                    <section class="ltn__utilize-menu-inner ltn__scrollbar">
                        <section class="ltn__utilize-menu-head">
                            <span class="ltn__utilize-menu-title">Cart</span>
                            <button class="ltn__utilize-close">×</button>
                        </section>
                        <section class="mini-cart-product-area ltn__scrollbar" id="cartInfo">
                        </section>

                        <div class="mini-cart-footer">
                            <div class="mini-cart-sub-total">
                                <h5>@locaization["Subtotal"]: <span id="totalCartSum">0</span></h5>
                            </div>
                            <div class="btn-wrapper">
                                <a asp-action="Index" asp-controller="Cart" asp-area="" class="theme-btn-1 btn btn-effect-1">@locaization["ViewCart"]</a>
                                <a asp-action="Index" asp-controller="Checkout" asp-area="" class="theme-btn-2 btn btn-effect-2">@locaization["Checkout"]</a>
                            </div>

                        </div>
                    </section>


                </section>
            </main>

            <section id="ltn__utilize-mobile-menu" class="ltn__utilize ltn__utilize-mobile-menu">
                <section class="ltn__utilize-menu-inner ltn__scrollbar">
                    <section class="ltn__utilize-menu-head">
                        <div class="site-logo">
                            <a href="index.html"><img src="/template-user/ltr/img/logo.png" alt="Logo"></a>
                        </div>
                        <button class="ltn__utilize-close">×</button>
                    </section>
                    <section class="ltn__utilize-menu-search-form">
                        <form asp-action="Search" asp-controller="Product" asp-area="">
                            <input type="text" autocomplete="off" placeholder="@locaization["Search"]...">
                            <button><i class="icon-magnifier"></i></button>
                        </form>
                    </section>
                    <section class="ltn__utilize-menu">
                        <ul>
                            <li>
                                <a asp-action="Index" asp-controller="Home" asp-area="">@locaization["Home"]</a>

                            </li>
                            <li><a asp-action="Index" asp-controller="AboutUs" asp-area="">@locaization["About"]</a></li>
                            <li>
                                <a asp-area="" asp-action="Index" asp-controller="Product">@locaization["Products"]</a>

                            </li>


                            <li><a asp-area="" asp-action="Index" asp-controller="Contact">@locaization["Contact"]</a></li>
                        </ul>
                    </section>
                    <section class="ltn__utilize-buttons ltn__utilize-buttons-2">
                        <ul>
                            <li>
                                <a asp-action="Index" asp-controller="Account" asp-area="" title="My Account">
                                    <span class="utilize-btn-icon">
                                        <i class="icon-user"></i>
                                    </span>
                                    @locaization["MyAccount"]
                                </a>
                            </li>

                            <li>
                                <a href="#" title="Shoping Cart">
                                    <span class="utilize-btn-icon">
                                        <i class="icon-handbag"></i>
                                        <sup id="totalCount-mobile">0</sup>
                                    </span>
                                    @locaization["ShopingCart"]
                                </a>
                            </li>
                        </ul>
                    </section>

                </section>
            </section>


            <div class="ltn__utilize-overlay"></div>

            @RenderBody()



            <!--Cart Module-->

            <div class="ltn__modal-area ltn__add-to-cart-modal-area">
                <div class="modal fade" id="add_to_cart_modal" tabindex="-1">
                    <div class="modal-dialog modal-md" role="document">
                        <div class="modal-content" id="Card-Product">


                        </div>
                    </div>
                </div>
            </div>

            <!--End Cart-->
            @if (CultureInfo.CurrentCulture.Name.Contains("ar"))
            {
                <script src="~/template-user/rtl/js/plugins.min.js"></script>
                <script src="~/template-user/rtl/js/main.min.js"></script>
            }
            else
            {
                <script src="~/template-user/ltr/js/plugins.min.js"></script>
                <script src="~/template-user/ltr/js/main.min.js"></script>
            }
            <script src="~/lib/alertifyjs/alertify.min.js"></script>


            <script src="~/template-user/all/cart.js"></script>

            @RenderSection("scripts", required: false)
        </body>

    </html>
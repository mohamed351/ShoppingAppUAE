@inject IConfiguration configuration
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title> Shopping Application - @ViewData["Title"] </title>

    @RenderSection("metaTags",false)

    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="shortcut icon" href="~/favicon.ico" type="image/x-icon" />

    <link rel="stylesheet" href="~/template-user/ltr/css/font-icons.css" />
    <link rel="stylesheet" href="~/template-user/ltr/css/plugins.css" />
    <link rel="stylesheet" href="~/template-user/ltr/css/style.css" />
    <link rel="stylesheet" href="~/template-user/ltr/css/responsive.css" />
    <link href="~/lib/alertifyjs/css/alertify.css" rel="stylesheet" />
    @RenderSection("styles",false)
</head>

<body>

    <input type="hidden"  id="GlobalCurrencyCode" value="@configuration["CompanyInfo:DefaultCurrency"]" />
    <main class="body-wrapper">

     
        <header class="ltn__header-area ltn__header-3 section-bg-6">
         
            <section class="ltn__header-middle-area">
                <section class="container">
                    <section class="row">
                        <section class="col">
                            <div class="site-logo">
                                <a asp-action="Index" asp-controller="Home" asp-area=""><img src="~/template-user/ltr/img/logo.png" alt="Logo"></a>
                            </div>
                        </section>
                        <section class="col header-contact-serarch-column d-none d-xl-block">
                            <div class="header-contact-search">
                              
                                <section class="header-feature-item">
                                    <section class="header-feature-icon">
                                        <i class="icon-phone"></i>
                                    </section>
                                    <article class="header-feature-info">
                                        <h6>Phone</h6>
                                        <p><a href="tel:0123456789">+0123-456-789</a></p>
                                    </article>
                                </section>
                                <!-- header-search-2 -->
                                <section class="header-search-2">
                                    <form id="#123" method="get" action="#">
                                        <input type="text" name="search" value="" placeholder="Search here..." />
                                        <button type="submit">
                                            <span><i class="icon-magnifier"></i></span>
                                        </button>
                                    </form>
                                </section>
                            </div>
                        </section>
                        <section class="col">
                            <section class="ltn__header-options">
                                <ul>

                                    <li class="d-none">
                                        <!-- header-search-1 -->
                                        <section class="header-search-wrap">
                                            <section class="header-search-1">
                                                <section class="search-icon">
                                                    <i class="icon-magnifier  for-search-show"></i>
                                                    <i class="icon-magnifier-remove  for-search-close"></i>
                                                </section>
                                            </section>
                                            <section class="header-search-1-form">
                                                <form id="#" method="get" action="#">
                                                    <input type="text" name="search" value="" placeholder="Search here..." />
                                                    <button type="submit">
                                                        <span><i class="icon-magnifier"></i></span>
                                                    </button>
                                                </form>
                                            </section>
                                        </section>
                                    </li>


                                    <li>
                                        <!-- user-menu -->
                                        <section class="ltn__drop-menu user-menu">
                                            <ul>
                                                <li>
                                                    <a href="#"><i class="icon-user"></i></a>
                                                    <ul>

                                                        @if (!User.Identity.IsAuthenticated)
                                                        {
                                                            <li><a asp-action="Login" asp-area="Identity" asp-controller="Account">Sign In</a></li>
                                                            <li><a asp-action="Register" asp-area="Identity" asp-controller="Account">Register</a></li>

                                                        }
                                                        @if (User.Identity.IsAuthenticated)
                                                        {
                                                            <li><a href="#">My Account</a></li>
                                                            <li><a href="wishlist.html">Wishlist</a></li>
                                                            <li>
                                                            <li>
                                                                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                                                    <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
                                                                </form>
                                                            </li>
                                                    </li>

                                                }
                                                    </ul>


                                                </section>


                                            </li>

                                            <li>
                                                <!-- mini-cart 2 -->
                                                <section class="mini-cart-icon mini-cart-icon-2">
                                                    <a href="#ltn__utilize-cart-menu" class="ltn__utilize-toggle">
                                                        <span class="mini-cart-icon">
                                                            <i class="icon-handbag"></i>
                                                            <sup id="totalCount">0</sup>
                                                        </span>

                                                    </a>
                                                </section>



                                            </li>






                                            <li>
                                                <!-- Mobile Menu Button -->
                                                <section class="mobile-menu-toggle d-lg-none">
                                                    <a href="#ltn__utilize-mobile-menu" class="ltn__utilize-toggle">
                                                        <svg viewBox="0 0 800 600">
                                                            <path d="M300,220 C300,220 520,220 540,220 C740,220 640,540 520,420 C440,340 300,200 300,200" id="top"></path>
                                                            <path d="M300,320 L540,320" id="middle"></path>
                                                            <path d="M300,210 C300,210 520,210 540,210 C740,210 640,530 520,410 C440,330 300,190 300,190" id="bottom" transform="translate(480, 320) scale(1, -1) translate(-480, -318) "></path>
                                                        </svg>
                                                    </a>
                                                </section>
                                            </li>
                                        </ul>
                                    </section>
                                </section>
                            </section>
                        </section>

                    </section>
                    <section class="header-bottom-area ltn__border-top ltn__header-sticky  ltn__sticky-bg-white ltn__primary-bg---- menu-color-white---- d-none d-lg-block">
                        <section class="container">
                            <section class="row">
                                <section class="col header-menu-column justify-content-center">
                                    <section class="sticky-logo">
                                        <div class="site-logo">
                                            <a asp-area="" asp-action="Index"  title="Home" asp-controller="Home"><img src="~/template-user/ltr/img/logo.png" alt="Logo"></a>
                                        </div>
                                    </section>
                                    <section class="header-menu header-menu-2">
                                        <nav>
                                            <section class="ltn__main-menu">
                                                <ul>
                                                    <li>
                                                        <a asp-area="" title="Home" asp-action="Index" asp-controller="Home">Home</a>

                                                    </li>
                                                    <li>
                                                        <a asp-area="" title="Products" asp-action="Index" asp-controller="Product">Products</a>
                                                    </li>

                                                    <li><a asp-area="" title="Contact" asp-action="Index" asp-controller="Contact">Contact</a></li>

                                                    <li><a asp-area="" title="About" asp-action="Index" asp-controller="AboutUs" >About</a></li>
                                                </ul>
                                            </section>
                                        </nav>
                                    </section>
                                </section>
                            </section>
                        </section>
                    </section>
                    <!-- header-bottom-area end -->
                </header>
            
                    <section id="ltn__utilize-cart-menu" class="ltn__utilize ltn__utilize-cart-menu">
                        <section class="ltn__utilize-menu-inner ltn__scrollbar">
                            <section class="ltn__utilize-menu-head">
                                <span class="ltn__utilize-menu-title">Cart</span>
                                <button class="ltn__utilize-close">×</button>
                            </section>
                            <section class="mini-cart-product-area ltn__scrollbar" id="cartInfo">
                            </section>

                            <div class="mini-cart-footer">
                                <div class="mini-cart-sub-total">
                                    <h5>Subtotal: <span id="totalCartSum">0</span></h5>
                                </div>
                                <div class="btn-wrapper">
                                    <a asp-action="Index" asp-controller="Cart" asp-area="" class="theme-btn-1 btn btn-effect-1">View Cart</a>
                                    <a asp-action="Index" asp-controller="Checkout" asp-area="" class="theme-btn-2 btn btn-effect-2">Checkout</a>
                                </div>
                                
                            </div>
                        </section>


                    </section>
            </main>
           
            <section id="ltn__utilize-mobile-menu" class="ltn__utilize ltn__utilize-mobile-menu">
                <section class="ltn__utilize-menu-inner ltn__scrollbar">
                    <section class="ltn__utilize-menu-head">
                        <div class="site-logo">
                            <a href="index.html"><img src="/template-user/ltr/img/logo.png" alt="Logo"></a>
                        </div>
                        <button class="ltn__utilize-close">×</button>
                    </section>
                    <section class="ltn__utilize-menu-search-form">
                        <form action="#">
                            <input type="text" placeholder="Search...">
                            <button><i class="icon-magnifier"></i></button>
                        </form>
                    </section>
                    <section class="ltn__utilize-menu">
                        <ul>
                            <li>
                                <a asp-action="Index" asp-controller="Home" asp-area="">Home</a>

                            </li>
                            <li><a asp-action="Index" asp-controller="AboutUs" asp-area="" >About Us</a></li>
                            <li>
                                <a asp-area="" asp-action="Index" asp-controller="Product">Products</a>

                            </li>


                            <li><a asp-area="" asp-action="Index" asp-controller="Contact">Contact</a></li>
                        </ul>
                    </section>
                    <section class="ltn__utilize-buttons ltn__utilize-buttons-2">
                        <ul>
                            <li>
                                <a asp-action="Index" asp-controller="Account" asp-area="" title="My Account">
                                    <span class="utilize-btn-icon">
                                        <i class="icon-user"></i>
                                    </span>
                                    My Account
                                </a>
                            </li>
                           
                            <li>
                                <a href="#" title="Shoping Cart">
                                    <span class="utilize-btn-icon">
                                        <i class="icon-handbag"></i>
                                        <sup id="totalCount-mobile">0</sup>
                                    </span>
                                    Shoping Cart
                                </a>
                            </li>
                        </ul>
                    </section>
                 
                </section>
            </section>
       

            <div class="ltn__utilize-overlay"></div>

            @RenderBody()
        


            <!--Cart Module-->

            <div class="ltn__modal-area ltn__add-to-cart-modal-area">
                <div class="modal fade" id="add_to_cart_modal" tabindex="-1">
                    <div class="modal-dialog modal-md" role="document">
                        <div class="modal-content" id="Card-Product">


                        </div>
                    </div>
                </div>
            </div>

            <!--End Cart-->

            <script src="~/template-user/ltr/js/plugins.js"></script>
            <script src="~/template-user/ltr/js/main.js"></script>
            <script src="~/lib/alertifyjs/alertify.js"></script>

            <script>

                function buildCart(currentCart) {
                    let cartItems = JSON.parse(currentCart);
                    $("#totalCount").text(cartItems.length);
                    $("#totalCount-mobile").text(cartItems.length); 
                    $(".totalCount")
                    console.log(currentCart);
                    let cartItemsHtml = cartItems.map(function (data) {
                        return `<div class="mini-cart-item clearfix">
                                                            <div class="mini-cart-img">
                                                                <a href="#"><img src="/images/${data.imageURL}" alt="${data.productName}"></a>
                                                                <span class="mini-cart-item-delete" data-id="${data.productId}"><i class="icon-trash"></i></span>
                                                            </div>
                                                            <div class="mini-cart-info">
                                                                <h6><a href="#">${data.productName}</a></h6>
                                                                <span class="mini-cart-quantity"> <span class='product-qtu-data'> ${data.Quantity} </span> x <span class="reloader product-price-data" data-id="${data.productId}" > <span> </span>
                                                            </div>
                                                        </div>`
                    });

                    $("#cartInfo").html("");
                    $("#cartInfo").html(cartItemsHtml);
                    return cartItems;
                }
                $(document).ready(function () {

                    getPrices();
                });
                $(document).on("click", ".mini-cart-item-delete", function () {
             
                    let currentDeletedItem = +$(this).attr("data-id");
                    let jsonData = localStorage.getItem("cart");
                    if (jsonData) {
                        let oldCart = JSON.parse(jsonData);
                        let newCart = oldCart.filter(a => a.productId != currentDeletedItem);
                        localStorage.setItem("cart",JSON.stringify( newCart));
                        buildCart(localStorage.getItem("cart"));
                        $("#totalCartSum").text(buildTotal());
                        getPrices();
                    }
                });

                function buildTotal() {
                    let sumTotal = 0;
                    $("#cartInfo .mini-cart-item").each(function () {
                        sumTotal+= +$(this).find(".product-qtu-data").text() * +$(this).find(".product-price-data").text();
                    });
                    return sumTotal;
                }

                function getPrices() {
                    let currentCart = localStorage.getItem("cart");
                    if (currentCart) {
                        let cartItems = buildCart(currentCart);
                       
                        $.ajax({
                            url: "/Product/GetProductPrices",
                            method: "POST",
                            contentType: "application/json",
                            type: "json",
                            data: JSON.stringify({ producIds: cartItems.map(a => a.productId) }),
                            success: function (result) {
                                let myCart =JSON.parse( localStorage.getItem("cart"));
                               
                                for (let item of result) {
                                    $(`#cartInfo .product-price-data[data-id='${item.productID}']`).text(item.purchasingPrice );
                                    myCart.find(a => a.productId == item.productID).price = item.purchasingPrice;

                                 
                                }
                                localStorage.setItem("cart", JSON.stringify(myCart));
                                $("#totalCartSum").text(buildTotal() + $("#GlobalCurrencyCode").val());
                            }
                        });
                    }

                }

                $(document).on("click", ".product-cart-item", function () {
                    let productId = $(this).attr("data-id");
                    $.ajax({
                        url: "/Product/AddToCardModel",
                        data: { id: productId },
                        success: function (result) {
                            $("#Card-Product").html(result);
                            $("#add_to_cart_modal").modal("show");

                        }
                    })
                });
                $(document).on("click", ".add-cart-local", function () {

                    const productData = {
                        productId: $(this).attr("data-id"),
                        imageURL: $(this).attr("data-image"),
                        productName: $(this).attr("data-name")
                    };

                    let currentCart = localStorage.getItem("cart");
                    if (currentCart == null) {
                        localStorage.setItem("cart", "[]");
                    }
                    currentCart = JSON.parse(localStorage.getItem("cart"));
                    let proceessCart = currentCart.find(a => a.productId == productData.productId);
                    if (proceessCart) {
                        proceessCart.Quantity++;
                    }
                    else {
                        currentCart.push({ ...productData, Quantity: 1 });
                    }

                    localStorage.setItem("cart", JSON.stringify(currentCart));
                  
                    buildCart(localStorage.getItem("cart"));
                    alertify.success("Item Add to Cart Successfully", 300);
                    getPrices();
                });

            </script>

            @RenderSection("scripts", required: false)
        </body>

</html>
        <link href="~/template-user/ltr/css/english-plugin-bundle.ltr.min.css" rel="stylesheet" />
        <link href="~/template-user/ltr/css/english-style-bundle.ltr.min.css" rel="stylesheet" />


    }

    <link href="~/lib/alertifyjs/css/alertify.min.css" rel="stylesheet" />
    <style>
        html {
            overflow-x: hidden !important;
        }
    </style>
    <link href="~/css/icons/font-awesome/css/fontawesome.min.css" rel="stylesheet" />
    @RenderSection("styles", false)
    <style>
        .setting-top-bar {
           
            overflow-y: visible;
            padding: 0 10px;
            background-color: #272829;
            padding: 10px;
        }
            .setting-top-bar .fa{
                color:#fff;
            }

            .nice-select {
                z-index: 9999;
            }

        .icon-size {
            font-size: 32px;
            padding: 0 10px;
        }

        .ltn__utilize-cart-menu {
            z-index: 99999;
        }
        .modal-backdrop{
            z-index:9999999;
        }
        .modal {
            z-index:999999999;
        }
        .active-color{
            background-color:var(--ltn__secondary-color) !important;
            color:#fff !important;
        }
        :root{
            --ltn__primary-color: #565656;
            --ltn__secondary-color: #d21717;
            --ltn__heading-color: #010101;
            --ltn__paragraph-color: #000;
            --ltn__body-color: #666;
            --ltn__primary-color-2: #041113;
            --ltn__primary-color-3: #133236;
            --ltn__secondary-color-2: #d21717;
            --ltn__secondary-color-3: #d21717;
        }
        .ltn__utilize-overlay{
            z-index:99998;
        }


    </style>
</head>

<body>

    <section class="d-flex justify-content-end setting-top-bar">

        <form asp-action="Cookie" asp-area="" asp-controller="Home" method="post" class="d-flex align-items-center">


@inject IViewLocalizer localization
@model ShoppingAppUAE.Models.ProductViewModel

@section styles{
    <link href="~/template-user/all/loading.css" rel="stylesheet" />
    <style>
        .category-link.active, .brand-link.active {
            color: var(--danger);
        }

        .loading-bar {
            background: rgba(200, 200, 200, 0.75);
            color: #fff;
            height: 100%;
            width: 100%;
            position: fixed;
            z-index: 999999;
            top: 0%;
            left: 0%;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        #sider-price-range .ui-slider-range {
            background-color: var(--ltn__secondary-color);
        }
        .product-img{
            max-height:350px;
            min-height:350px;
        }
      @@media only screen and (max-width: 60rem){
            .col-sm-6{
                width:50% !important;
                min-height: auto !important;
            }
        }
    </style>
}



<div class="ltn__utilize-overlay"></div>

<div class="loading-bar">
    <div style="display:inline-block" class="loadingio-spinner-spinner-g5gku4jwumr">
        <div class="lds-spinner"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>
    </div>
</div>

<div class="ltn__breadcrumb-area ltn__breadcrumb-area-4 ltn__breadcrumb-color-white---">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="ltn__page-title">@localization["Products"]</h1>
                    <div class="ltn__breadcrumb-list">
                        <ul>
                            <li><a asp-action="Index" asp-controller="Home">Home</a></li>
                            <li>@localization["Products"]</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="ltn__product-area ">
    <div class="container">
        <div class="row">
            <div class="col-lg-9 order-lg-2 mb-100">
                <div class="ltn__shop-options">
                    <ul>


                        <li>
                            <div class="showing-product-number text-right">
                                <span>@localization["Showing"] 12 -  <span id="totalProducts"></span> @localization["results"]</span>
                            </div>
                        </li>

                        <li>
                            <div class="short-by text-center">
                                <select class="nice-select">
                                    <option>@localization["DefaultSort"]</option>

                                    <option value="0">@localization["SortBy"] @localization["hightolowPirce"] </option>
                                    <option value="1">@localization["SortBy"] @localization["lowtohighPirce"] </option>
                                </select>
                            </div>
                            <div class="ltn__grid-list-tab-menu ">
                                <div class="nav">
                                    <a class="active show" data-toggle="tab" href="#liton_product_grid"><i class="icon-grid"></i></a>
                                    <a data-toggle="tab" href="#liton_product_list"><i class="icon-menu"></i></a>
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
                <div class="tab-content">
                    <section class="tab-pane fade active show" id="liton_product_grid">
                        <section class="ltn__product-tab-content-inner ltn__product-grid-view">

                            <section class="row" id="product-grid">
                            </section>
                        </section>
                    </section>



                    <div class="tab-pane fade" id="liton_product_list">
                        <div class="ltn__product-tab-content-inner ltn__product-list-view">

                            <div class="row" id="product-full-grid-item">

                            </div>
                        </div>
                    </div>
                </div>
                <div class="ltn__pagination-area text-center">
                    <div class="ltn__pagination ltn__pagination-2" id="pageing">

                    </div>
                </div>
            </div>
            <div class="col-lg-3  mb-100">
                <aside class="sidebar ltn__shop-sidebar">
                    <!-- Search Widget -->
                    <div class="widget ltn__search-widget">
                        <form id="searchForm">
                            <input type="text" id="txtSearch-grid" name="search" placeholder="@localization["SearchKeyWord"]">
                            <button type="submit"><i class="icon-magnifier"></i></button>
                        </form>
                    </div>


                    <div class="widget ltn__price-filter-widget">
                        <h4 class="ltn__widget-title">@localization["Pirce"]</h4>
                        <input type="hidden" id="maxPirce" value="@Model.MaxValue" />
                        <input type="hidden" id="minPirce" value="@Model.MinValue" />
                        <input type="hidden" id="selected-maxPrice" value="@Model.MaxValue" />
                        <input type="hidden" id="selected-minPrice" value="@Model.MinValue" />
                        <div class="d-flex justify-content-end">
                            <button id="btn-apply">@localization["Apply"]</button>
                        </div>
                       <p id="pirceRange">
                          @Model.MinValue - @Model.MaxValue
                       </p>
                        <div id="sider-price-range">


                        </div>
                    </div>

                    <nav class="widget ltn__menu-widget">
                        <h4 class="ltn__widget-title">@localization["Categories"]</h4>
                        <ul id="category-list">
                            <li> <a href="#" class="category-link active"> @localization["All"] </a></li>
                            @foreach (var item in Model.CategoryViewModels)
                            {
                                <li>
                                    <a href="#" class="category-link" data-id="@item.ID">
                                        @if (CultureInfo.CurrentCulture.Name.Contains("ar"))
                                        {

                                            @item.NameArabic
                                        }
                                        else
                                        {

                                            @item.NameEnglish
                                        }

                                    </a>
                                </li>
                            }

                        </ul>
                    </nav>

                    <nav class="widget ltn__menu-widget">
                        <h4 class="ltn__widget-title">@localization["Brands"]</h4>
                        <ul id="brand-list">
                            <li> <a href="#" class="brand-link active"> @localization["All"] </a></li>
                            @foreach (var item in Model.BrandViewModel)
                            {
                                <li>
                                    <a href="#" class="brand-link" data-id="@item.ID">

                                        @if (CultureInfo.CurrentCulture.Name.Contains("ar"))
                                        {
                                            @item.ArabicName
                                        }
                                        else
                                        {

                                            @item.EnglishName
                                        }
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>








                </aside>
            </div>
        </div>
    </div>
</div>


<!-- preloader area start -->
<div class="preloader d-none" id="preloader">
    <div class="preloader-inner">
        <div class="spinner">
            <div class="dot1"></div>
            <div class="dot2"></div>
        </div>
    </div>
</div>
<!-- preloader area end -->
@section scripts{
    <script src="~/lib/pagination.min.js"></script>
    <script>
        $("#sider-price-range").slider({
            range: true,
            max: +$("#maxPirce").val().replace("٫","."),
            values: [0, +$("#maxPirce").val().replace("٫", ".")],
            slide: function (event, ui) {

                $("#pirceRange").html("$" + ui.values[0] + " - $" + ui.values[1]);
                $("#selected-maxPrice").val(ui.values[1]);
                $("#selected-minPrice").val(ui.values[0]);

            }

        });

        function setValues() {
            searchObject.maxValue = $("#selected-maxPrice").val();
            searchObject.minValue = $("#selected-minPrice").val();
            searchObject.maxValue = $("#selected-maxPrice").val();
            searchObject.search = $("#txtSearch-grid").val();
            searchObject.categoryId = $("#category-list li a.active").attr("data-id");
            searchObject.brandId = $("#brand-list li a.active").attr("data-id");

        }
        $("#btn-apply").on("click", function () {
            $('#pageing').pagination("destroy");
            setValues();
            createPaging();
        });
       
        $(document).ajaxStart(function () {
            $(".loading-bar ").css("display", "flex");
        });
        $(document).ajaxStop(function () {
            $(".loading-bar ").css("display", "none");
        });
        var searchObject = { brandId: null, categoryId: null, search: "", maxValue: $("#selected-maxPrice").val(), minValue: $("#selected-minPrice").val() };
        $(document).ready(function () {
            createPaging();
        });
        $("#searchForm").submit(function (e) {
            e.preventDefault();
            $('#pageing').pagination("destroy");
            setValues();
            createPaging();

        });
        function createPaging() {
            $("#pageing").pagination({
                dataSource: "/Product/GetProducts?" + getSearch(),
                pageSize: 12,
                locator: "product",
                totalNumberLocator: function (response) {
                    $("#totalProducts").text(response.totalProduct);
                    return response.totalProduct;

                },
                callback: function (response, pagination) {
                    $("#product-grid").html("");
                    $("#product-full-grid-item").html("");
                    for (var item of response) {
                        console.log(item);
                        $("#product-grid").append(BuildCard(item));
                        $("#product-full-grid-item").append(BuildBigCard(item));
                    }
                },
                beforeInit: function () {
                  
                 
                },
                afterRender: function () {

                }
            });
        }

        function getSearch() {
            let search = new URLSearchParams();
            for (let key in searchObject) {
                search.append(key, searchObject[key]);
            }
            return search.toString();
        }

        $(".category-link").on("click", function () {

            $("#category-list li a").removeClass("active");
            $(this).addClass("active");
            setValues();
            $('#pageing').pagination("destroy");
            createPaging();
        });
        $(".brand-link").on("click", function () {

            $("#brand-list li a").removeClass("active");
            $(this).addClass("active");
            setValues();
            $('#pageing').pagination("destroy");
            createPaging();
        });

        function BuildCard(currentItem) {

            let processExchnageRate = +$("#currency-app option:selected").attr("data-rate").replace("٫", ".")

            return ` <section class="col-xl-4 col-sm-6 ">
                                                <div class="ltn__product-item text-center">
                                                    <div class="product-img">
                                                        <a href="/Product/CurrentProduct/${currentItem.productID}"><img loading="lazy" src="/images/${currentItem.imageURL}" alt="${currentItem.productNameEnglish}"></a>

                                                        <div class="product-hover-action product-hover-action-2">
                                                            <ul>
                                                              <li class="add-wish-list">
                                                                    <a  title="Add to Wish" class="product-wish-item"   data-id="${currentItem.productID}">
                                                                        <span class="cart-text d-none d-xl-block "  >  <i class="icon-heart white-color "></i> </span>
                                                                        <span class="d-block d-xl-none"> <i class="icon-heart white-color "></i></span>
                                                                    </a>
                                                                </li>
                                                                <li class="add-to-cart">
                                                                    <a  title="Add to Cart" class="product-cart-item"   data-id="${currentItem.productID}">
                                                                        <span class="cart-text d-none d-xl-block "  >     <i class="icon-handbag white-color"></i> </span>
                                                                        <span class="d-block d-xl-none"> <i class="icon-handbag white-color"></i> </span>
                                                                    </a>
                                                                </li>
                                                                   

                                                            </ul>
                                                        </div>
                                                    </div>
                                                    <div class="product-info">
                                                        <h2 class="product-title"><a href="/Product/CurrentProduct/${currentItem.productID}">${currentItem.productNameEnglish}</a></h2>
                                                        <div class="product-price">
                                                            <span>${(currentItem.purchasingPrice * (processExchnageRate))} ${$("#currency-app").val()}</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </section>
                `
        }


        function BuildBigCard(currentItem) {

            let processExchnageRate = +$("#currency-app option:selected").attr("data-rate").replace("٫", ".")
            return `
                                 <div class="col-lg-12">
                                            <div class="ltn__product-item">
                                                <div class="product-img">
                                                    <a href="/Product/CurrentProduct/${currentItem.productID}"><img loading="lazy" src="/images/${currentItem.imageURL}" alt="${currentItem.productNameEnglish}"></a>
                                                    <div class="product-badge">
                                                        <ul>
                                                            <li class="badge-1">Hot</li>
                                                        </ul>
                                                    </div>
                                                </div>
                                                <div class="product-info">
                                                    <h2 class="product-title"><a href="/Product/CurrentProduct/${currentItem.productID}">${currentItem.productNameEnglish}</a></h2>
                                                    <div class="product-price">
                                                        <span>${(currentItem.purchasingPrice * (processExchnageRate))} ${$("#currency-app").val()}</span>
                                                    </div>

                                                    <div class="product-brief">
                                                               testing
                                                    </div>
                                                    <div class="product-hover-action product-hover-action-2">
                                                        <ul>

                                                            <li class="add-to-cart">
                                                                <a title="Add to Cart" class='product-cart-item' data-id=${currentItem.productID}>
                                                                    <span class="cart-text d-none d-xl-block"><i class="icon-handbag white-color"></i> </span>
                                                                    <span class="d-block d-xl-none"><i class="icon-handbag"></i></span>
                                                                </a>
                                                            </li>

                                                              <li class="add-to-wish">
                                                                <a  title="Add to Cart" class='product-wish-item' data-id=${currentItem.productID}>
                                                                    <span class="cart-text d-none d-xl-block"><i class="icon-heart white-color "></i></span>
                                                                    <span class="d-block d-xl-none"><i class="icon-handbag"></i></span>
                                                                </a>
                                                            </li>
            
                                        

                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                    `
        }
    </script>

}
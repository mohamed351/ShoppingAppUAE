@model ShoppingAppUAE.Data.Product
@{
    ViewData["Title"] = "CurrentProduct";
}



<div class="ltn__utilize-overlay"></div>


<div class="ltn__breadcrumb-area ltn__breadcrumb-area-4 ltn__breadcrumb-color-white---">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="ltn__page-title">Product</h1>
                    <div class="ltn__breadcrumb-list">
                        <ul>
                            <li><a asp-action="Index" asp-controller="Product">Prouct</a></li>
                            <li>@Model.ProductNameEnglish</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<section class="ltn__shop-details-area pb-70">
    <section class="container">
        <section class="row">
            <section class="col-lg-12 col-md-12">
                <section class="ltn__shop-details-inner">
                    <section class="row">
                        <section class="col-md-6">
                            <section class="ltn__shop-details-img-gallery ltn__shop-details-img-gallery-2">
                                <section class="ltn__shop-details-small-img slick-arrow-2">
                                    <div class="single-small-img">
                                        <img src="/images/@Model.ImageURL" alt="@Model.ProductNameEnglish">
                                    </div>

                                </section>
                                <section class="ltn__shop-details-large-img">
                                    <section class="single-large-img">
                                        <a href="/images/@Model.ImageURL" data-rel="lightcase:myCollection">
                                            <img src="/images/@Model.ImageURL" alt="@Model.ProductNameEnglish">

                                        </a>
                                    </section>

                                </section>
                            </section>
                        </section>
                        <section class="col-md-6">
                            <section class="modal-product-info shop-details-info pl-0">
                                <h3>@Model.ProductNameEnglish</h3>
                                <section class="product-price-ratting mb-20">
                                    <ul>
                                        <li>
                                            <div class="product-price">
                                                <span>@Model.PurchasingPrice </span>

                                            </div>
                                        </li>

                                    </ul>
                                </section>
                                <section class="modal-product-brief">
                                    @Html.Raw(Model.DescriptionEnglish)
                                </section>

                                <section class="ltn__product-details-menu-2 product-cart-wishlist-btn mb-30">
                                    <ul>

                                        <li>
                                            <button class="theme-btn-1 btn btn-effect-1 d-add-to-cart add-cart-local" data-id="@Model.ProductID" data-name="@Model.ProductNameEnglish" data-image="@Model.ImageURL" title="Add to Cart">
                                                <span>ADD TO CART</span>
                                            </button>
                                        </li>
                                        <li>
                                            <a href="#" class="btn btn-effect-1 d-add-to-wishlist" title="Add to Cart">
                                                <i class="icon-heart"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </section>
                                <section class="ltn__social-media mb-30">

                                    <!-- Go to www.addthis.com/dashboard to customize your tools -->
                                    <div class="addthis_inline_share_toolbox"></div>

                                </section>
                                <section class="modal-product-meta ltn__product-details-menu-1 mb-30">
                                    <ul>

                                        <li>
                                            <strong>Categories:</strong>
                                            <span>
                                                <a href="#">@Model.Category.CategoryNameEnglish</a>
                                            </span>
                                        </li>
                                        <li>
                                            <strong>Tags:</strong>
                                            <span>
                                                @Model.SEOEnglishKeyWords
                                            </span>
                                        </li>
                                    </ul>
                                </section>

                            </section>
                        </section>
                    </section>
                </section>
            </section>
        </section>
    </section>
</section>

@section scripts{
    <!-- Go to www.addthis.com/dashboard to customize your tools -->
    <script type="text/javascript" src="//s7.addthis.com/js/300/addthis_widget.js#pubid=ra-624606018f86ebfc"></script>


}


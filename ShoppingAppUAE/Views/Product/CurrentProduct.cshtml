@inject IConfiguration configuration
@inject IViewLocalizer locaization
@model ShoppingAppUAE.Data.Product
@{

    if (CultureInfo.CurrentCulture.Name.Contains("ar"))
    {
        ViewData["Title"] = Model.ProductNameArabic;
    }
    else
    {

        ViewData["Title"] = Model.ProductNameEnglish;
    }

}

@section metaTags{

    @if (CultureInfo.CurrentCulture.Name.Contains("ar"))
    {
        <meta name="title" content="@Model.SEOArabicTitle">
        <meta name="description" content="@Model.BreifDescriptionArabic" />
        <meta name="keywords" content="@Model.SEOArabicKeyWords" />

        <meta property="og:type" content="website">
        <meta property="og:url" content="@configuration["SEO:DomainName"]">
        <meta property="og:title" content="@Model.SEOArabicTitle">
        <meta property="og:description" content="@Model.BreifDescriptionArabic">
        <meta property="og:image" content="@configuration["SEO:DomainName"]/images/@Model.ImageURL">



        <meta property="twitter:card" content="website">
        <meta property="twitter:url" content="@configuration["SEO:DomainName"]">
        <meta property="twitter:title" content="@Model.SEOArabicTitle">
        <meta property="twitter:description" content="@Model.BreifDescriptionArabic">
        <meta property="twitter:image" content="@configuration["SEO:DomainName"]/images/@Model.ImageURL">



    }
    else
    {

        <meta name="title" content="@Model.SEOEnglishTitle">
        <meta name="description" content="@Model.BreifDescriptionEnglish" />
        <meta name="keywords" content="@Model.SEOEnglishKeyWords" />

        <meta property="og:type" content="website">
        <meta property="og:url" content="@configuration["SEO:DomainName"]">
        <meta property="og:title" content="@Model.SEOEnglishTitle">
        <meta property="og:description" content="@Model.BreifDescriptionEnglish">
        <meta property="og:image" content="@configuration["SEO:DomainName"]/images/@Model.ImageURL">



        <meta property="twitter:card" content="website">
        <meta property="twitter:url" content="@configuration["SEO:DomainName"]">
        <meta property="twitter:title" content="@Model.SEOEnglishTitle">
        <meta property="twitter:description" content="@Model.BreifDescriptionEnglish">
        <meta property="twitter:image" content="@configuration["SEO:DomainName"]/images/@Model.ImageURL">

    }
}



<div class="ltn__utilize-overlay"></div>


<section class="ltn__breadcrumb-area ltn__breadcrumb-area-4 ltn__breadcrumb-color-white---">
    <section class="container">
        <div class="row">
            <section class="col-lg-12">
                <section class="ltn__breadcrumb-inner text-center">
                    <h1 class="ltn__page-title">@locaization["Product"]</h1>
                    <nav class="ltn__breadcrumb-list">
                        <ul>
                            <li><a asp-action="Index" asp-controller="Product">@locaization["Product"]</a></li>
                            <li>

                                @if (CultureInfo.CurrentCulture.Name.Contains("ar"))
                                {

                                    @Model.ProductNameArabic

                                }
                                else
                                {
                                    @Model.ProductNameEnglish
                                }



                            </li>
                        </ul>
                    </nav>
                </section>
            </section>
        </div>
    </section>
</section>


<section class="ltn__shop-details-area pb-70">
    <section class="container">
        <section class="row">
            <section class="col-lg-12 col-md-12">
                <section class="ltn__shop-details-inner">
                    <section class="row">
                        <section class="col-md-6">
                            <section class="ltn__shop-details-img-gallery ltn__shop-details-img-gallery-2">
                                <section class="ltn__shop-details-small-img slick-arrow-2">
                                    <div class="single-small-img">
                                        <img src="/images/@Model.ImageURL" alt="@Model.ProductNameEnglish">
                                    </div>

                                </section>
                                <section class="ltn__shop-details-large-img">
                                    <section class="single-large-img">
                                        <a href="/images/@Model.ImageURL" data-rel="lightcase:myCollection">
                                            <img src="/images/@Model.ImageURL" alt="@Model.ProductNameEnglish">

                                        </a>
                                    </section>

                                </section>
                            </section>
                        </section>
                        <section class="col-md-6">
                            <section class="modal-product-info shop-details-info pl-0">
                                <h3>

                                    @if (CultureInfo.CurrentCulture.Name.Contains("ar"))
                                    {

                                        @Model.ProductNameArabic

                                    }
                                    else
                                    {
                                        @Model.ProductNameEnglish
                                    }




                                </h3>
                                <section class="product-price-ratting mb-20">
                                    <ul>
                                        <li>
                                            <div class="product-price">
                                                <span>@Model.PurchasingPrice @configuration["CompanyInfo:DefaultCurrency"] </span>

                                            </div>
                                        </li>

                                    </ul>
                                </section>
                                <section class="modal-product-brief">
                                    @Html.Raw(Model.DescriptionEnglish)
                                </section>

                                <section class="ltn__product-details-menu-2 product-cart-wishlist-btn mb-30">
                                    <ul>

                                        <li>
                                            <button class="theme-btn-1 btn btn-effect-1 d-add-to-cart add-cart-local" data-id="@Model.ProductID" data-name="@Model.ProductNameEnglish" data-image="@Model.ImageURL" title="Add to Cart">
                                                <span>@locaization["AddToCart"]</span>
                                            </button>
                                        </li>
                                        <li>
                                            <a href="#" class="btn btn-effect-1 d-add-to-wishlist" title="@locaization["AddToCart"]">
                                                <i class="icon-heart"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </section>
                                <section class="ltn__social-media mb-30">

                                    <!-- Go to www.addthis.com/dashboard to customize your tools -->
                                    <div class="addthis_inline_share_toolbox"></div>

                                </section>
                                <nav class="modal-product-meta ltn__product-details-menu-1 mb-30">
                                    <ul>

                                        <li>
                                            <strong>@locaization["Category"]:</strong>
                                            <span>
                                                <a href="#">@Model.Category.CategoryNameEnglish</a>
                                            </span>
                                        </li>

                                        <li>
                                            <strong>@locaization["Weight"]:</strong>
                                            <span>
                                                <a href="#">@Model.Weight</a>
                                            </span>
                                        </li>
                                        <li>
                                            <strong>@locaization["Tags"]:</strong>
                                            <span>
                                                @Model.SEOEnglishKeyWords
                                            </span>
                                        </li>
                                    </ul>
                                </nav>

                            </section>
                        </section>
                    </section>
                </section>
            </section>
        </section>
    </section>
</section>

@section scripts{
    <!-- Go to www.addthis.com/dashboard to customize your tools -->
    <script type="text/javascript" src="//s7.addthis.com/js/300/addthis_widget.js#pubid=ra-624606018f86ebfc"></script>


}


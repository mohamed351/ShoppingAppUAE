@model ShoppingAppUAE.Repository.Interfaces.DataTableViewModel<ShoppingAppUAE.Data.Product>
@using ShoppingAppUAE.Data
@{
    ViewData["Title"] = "Search";
    var currency = (Currency)ViewBag.Currency;
}

<input type="hidden" id="pagetotal" value="@Model.recordsTotal" />
<input type="hidden" id="search" value="@ViewBag.Search" />
<input type="hidden" id="pageNumber" value="@ViewBag.PageNumber" />
<input type="hidden" id="sort" value="@ViewBag.sort" />
@section styles{
    <style>
        @@media (max-width:40rem) {
            .card-item-smaller {
                width: 50% !important;
            }
        }
    </style>

}

<div class="ltn__breadcrumb-area ltn__breadcrumb-area-4 ltn__breadcrumb-color-white---">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="ltn__page-title">Shop</h1>
                    <div class="ltn__breadcrumb-list">
                        <ul>
                            <li><a asp-action="Index" asp-controller="Home">Home</a></li>
                            @if (CultureInfo.CurrentCulture.Name.Contains("ar"))
                            {
                                <li>@ViewBag.categoryArabic</li>
                            }
                            else
                            {
                                <li>@ViewBag.categoryEnglish</li>
                            }

                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="ltn__product-area mb-100">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__shop-options">
                    <ul>
                        <li>
                            <div class="showing-product-number text-right">
                                <span>Showing @Model.recordsTotal </span>
                            </div>
                        </li>
                        <li>
                            <div class="short-by text-center">

                                <select class="nice-select" id="sortData">

                                    <option value="0">Default sorting</option>
                                    <option value="1">Sort by price: high to low</option>
                                    <option value="2">Sort by price: low to high</option>

                                </select>
                            </div>
                            <div class="ltn__grid-list-tab-menu ">
                                <div class="nav">
                                    <a class="active show" data-toggle="tab" href="#liton_product_grid"><i class="icon-grid"></i></a>
                                    <a data-toggle="tab" href="#liton_product_list"><i class="icon-menu"></i></a>
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
                <div class="tab-content">
                    <div class="tab-pane fade active show" id="liton_product_grid">
                        <div class="ltn__product-tab-content-inner ltn__product-grid-view">
                            <div class="container">
                                <div class="row">
                                    @foreach (var item in Model.data)
                                    {
                                        <div class="col-xl-3 col-lg-4 col-xs-6 card-item-smaller">
                                            <div class="ltn__product-item text-center">
                                                <div class="product-img">
                                                    <a asp-action="CurrentProduct" asp-controller="Product" asp-route-id="@item.ProductID "><img src="/images/@item.ImageURL" alt="@item.ProductNameEnglish"></a>
                                                    <div class="product-badge">
                                                        <ul>
                                                            <li class="badge-1">@Convert.ToInt32(item.Discount) %</li>
                                                        </ul>
                                                    </div>
                                                    <div class="product-hover-action product-hover-action-2">
                                                        <ul>

                                                            <li class="add-to-cart">
                                                                <a href="#"  title="Add to Cart" class="product-cart-item"   data-id="@item.ProductID">
                                                                    <span class="cart-text d-none d-xl-block ">Add to Cart</span>
                                                                    <span class="d-block d-xl-none"><i class="icon-handbag"></i></span>
                                                                </a>
                                                            </li>

                                                        </ul>
                                                    </div>
                                                </div>
                                                <div class="product-info">
                                                    <h2 class="product-title"><a asp-controller="Product" asp-action="CurrentProduct" asp-route-id="@item.ProductID">@item.ProductNameEnglish </a></h2>
                                                    <div class="product-price">
                                                        <span> @(item.PurchasingPrice *currency.ExchangeRate)  @currency.CurrencyCode </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="liton_product_list">
                        <div class="ltn__product-tab-content-inner ltn__product-list-view">
                            <div class="row">
                                @foreach (var item in Model.data)
                                {
                                    <div class="col-lg-12">
                                        <div class="ltn__product-item">
                                            <div class="product-img">
                                                <a asp-controller="Product" asp-action="CurrentProduct" asp-route-id="@item.ProductID"><img src="/images/@item.ImageURL" alt="@item.ProductNameEnglish"></a>
                                                <div class="product-badge">
                                                    <ul>
                                                        <li class="badge-1"> @Convert.ToInt32(item.Discount) %</li>
                                                    </ul>
                                                </div>
                                            </div>
                                            <div class="product-info">
                                                <h2 class="product-title"><a asp-controller="Product" asp-action="CurrentProduct" asp-route-id="@item.ProductID">@item.ProductNameEnglish </a></h2>
                                                <div class="product-price">
                                                    <span>@(item.PurchasingPrice * currency.ExchangeRate) @currency.CurrencyCode</span>
                                                </div>

                                                <div class="product-brief">
                                                    @item.BreifDescriptionEnglish
                                                </div>
                                                <div class="product-hover-action product-hover-action-2">
                                                    <ul>
                                                        <li>
                                                            <a href="#" title="Quick View" data-toggle="modal" data-target="#quick_view_modal">
                                                                <i class="icon-magnifier"></i>
                                                            </a>
                                                        </li>
                                                        <li class="add-to-cart">
                                                            <a href="#"  title="Add to Cart" class="product-cart-item"   data-id="@item.ProductID">
                                                                <span class="cart-text d-none d-xl-block">Add to Cart</span>
                                                                <span class="d-block d-xl-none"><i class="icon-handbag"></i></span>
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a href="#" title="Quick View" data-toggle="modal" data-target="#quick_view_modal">
                                                                <i class="icon-shuffle"></i>
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                <!--  -->
                            </div>
                        </div>
                    </div>
                </div>
                <div class="ltn__pagination-area text-center">
                    <div class="ltn__pagination ltn__pagination-2" id="pageing">
                        @*<ul>
                                <li><a href="#"><i class="icon-arrow-left"></i></a></li>
                                <li><a href="#">1</a></li>
                                <li class="active"><a href="#">2</a></li>
                                <li><a href="#">3</a></li>
                                <li><a href="#">...</a></li>
                                <li><a href="#"><i class="icon-arrow-right"></i></a></li>
                            </ul>*@
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script src="~/lib/pagination.min.js"></script>

    <script>
    $('#pageing').pagination({
        dataSource:function(done) {
            var result = [];
            let end = +$("#pagetotal").val()
            for (var i = 1; i < end; i++) {
                result.push(i);
            }
            done(result);
        },
        pageSize: 12,
        pageNumber: +$("#pageNumber").val() ,
        callback: function (data, pagination) {
            let currentUrl = new URL(window.location.href);
            $("#txtSearchPhone").val(currentUrl.searchParams.get("search"));
           
            $("#sortData").val($("#sort").val());
            $("#sortData").niceSelect('update');
        },
        beforePageOnClick: function (data, x) {
            let currentUrl = new URL(window.location.href);
            currentUrl.searchParams.delete("page");
            currentUrl.searchParams.append("page", x);
            window.location.href = currentUrl.toString();

        }

    });
    $("#sortData").on("change", function () {
        let currentUrl = new URL(window.location.href);
        currentUrl.searchParams.delete("sort");
        currentUrl.searchParams.append("sort",+$(this).val());
        window.location.href = currentUrl.toString();
    });

    </script>

}
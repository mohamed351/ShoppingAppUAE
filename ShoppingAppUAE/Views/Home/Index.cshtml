@model ShoppingAppUAE.Models.HomeViewModels.HomePageViewModel

@inject IViewLocalizer locaization
@inject IConfiguration Configuration

@{
    var seoData = (URLInfo)ViewBag.SEO;
    ViewData["Title"] = "Home Page";

}


@section metaTags{
    <meta name="title" content="@seoData.Title">
    <meta name="description" content="@seoData.Description">
   

}

<section class="ltn__slider-area ltn__slider-3 ltn__slider-6 section-bg-1">
    <section class="ltn__slide-one-active slick-slide-arrow-1 slick-slide-dots-1 arrow-white---">

        @foreach (var item in Model.Banner)
        {
            <section class="ltn__slide-item ltn__slide-item-8 text-color-white---- bg-image bg-overlay-theme-black-80---" data-bg="/images/@item.ImageURL ">
                <section class="ltn__slide-item-inner">
                    <section class="container">
                        <section class="row">
                            <section class="col-lg-12 align-self-center">
                                <section class="slide-item-info">
                                    <section class="slide-item-info-inner ltn__slide-animation">
                                        <header class="slide-item-info">
                                            <section class="slide-item-info-inner ltn__slide-animation">
                                                <h1 class="slide-title animated ">

                                                    @if (CultureInfo.CurrentCulture.Name.Contains("ar"))
                                                    {
                                                        @item.ArabicTitle
                                                    }
                                                    else
                                                    {
                                                        @item.Title
                                                    }


                                                </h1>

                                                <article class="slide-brief animated">
                                                    @if (CultureInfo.CurrentCulture.Name.Contains("ar"))
                                                    {
                                                        <p style="color:#fff;">@item.ArabicParagrap </p>
                                                    }
                                                    else
                                                    {
                                                        <p style="color:#fff;">@item.Paragraph </p>
                                                    }

                                                </article>
                                                <section class="btn-wrapper animated">
                                                    <a asp-controller="Product" asp-action="Index" class="theme-btn-1 btn btn-round"> @locaization["ShoppingNow"] </a>
                                                </section>
                                            </section>
                                        </header>
                                    </section>
                                </section>

                            </section>
                        </section>
                    </section>
                </section>
            </section>
        }

    </section>
</section>


<div class="ltn__product-area ltn__product-gutter  pt-65 pb-40">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title-area text-center">
                    <h1 class="section-title section-title-border">new arrival items</h1>
                </div>
            </div>
        </div>
        <div class="row justify-content-center">
            @foreach (var item in Model.Products)
            {
                <!-- ltn__product-item -->
                <div class="col-lg-3 col-md-4 col-sm-6 col-6">
                    <div class="ltn__product-item text-center">
                        <div class="product-img">
                            <a asp-action="CurrentProduct" asp-route-id="@item.ProductID" asp-controller="Product"><img src="~/images/@item.ImageURL" alt="@item.ImageAlternativeText"></a>
                            <div class="product-badge">
                                <ul>
                                    <li class="badge-2">@item.Discount %</li>
                                </ul>
                            </div>
                            <div class="product-hover-action product-hover-action-2">
                                <ul>

                                                                  <li class="add-to-cart">
                                                                <a href="#" title="Add to Cart" class="product-cart-item" data-id="@item.ProductID">
                                                                    <span class="cart-text d-none d-xl-block "><i class="icon-handbag white-color"></i> </span>
                                                                    <span class="d-block d-xl-none"><i class="icon-handbag white-color"></i></span>
                                                                </a>

                                                            </li>
                                                            <li>
                                                                
                                                                 <a href="#" title="Add to WishList" class="product-wish-item" data-id="@item.ProductID">
                                                                    <span class="cart-text d-none d-xl-block "><i class="icon-heart white-color"></i> </span>
                                                                    <span class="d-block d-xl-none"><i class="icon-heart white-color "></i></span>
                                                                </a>
                                                            </li>

                                </ul>
                            </div>
                        </div>
                        <div class="product-info">
                            <h2 class="product-title"><a href="product-details.html">@item.ProductNameEnglish</a></h2>
                            <div class="product-price">
                                <span>@item.PurchasingPrice</span>

                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>



@foreach (var item in Model.Categories)
{
    <div class="ltn__product-slider-area ltn__product-gutter  pt-60 pb-40">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="section-title-area text-center">
                        <h1 class="section-title section-title-border">@item.CategoryNameEnglish </h1>
                    </div>
                </div>
            </div>
            <div class="row ltn__product-slider-item-four-active slick-arrow-1">
                <!-- ltn__product-item -->

                @foreach (var product in item.Products.Where(a => a.IsTop10))
                {
                    <div class="col-12">
                        <div class="ltn__product-item text-center">
                            <div class="product-img">
                                <a  asp-action="CurrentProduct" asp-route-id="@product.ProductID" asp-controller="Product"><img src="~/images/@product.ImageURL" alt="@product.ImageAlternativeText"></a>
                                <div class="product-badge">
                                    <ul>
                                        <li class="badge-2">@product.Discount %</li>
                                    </ul>
                                </div>
                                <div class="product-hover-action product-hover-action-2">
                                    <ul>
                                        @*<li>
                                            <a href="#" title="Quick View" data-toggle="modal" data-target="#quick_view_modal">
                                                <i class="icon-magnifier"></i>
                                            </a>
                                        </li>*@
                                        
                                                                  <li class="add-to-cart">
                                                                <a href="#" title="Add to Cart" class="product-cart-item" data-id="@product.ProductID">
                                                                    <span class="cart-text d-none d-xl-block "><i class="icon-handbag white-color"></i> </span>
                                                                    <span class="d-block d-xl-none"><i class="icon-handbag white-color"></i></span>
                                                                </a>

                                                            </li>
                                                            <li>
                                                                
                                                                 <a href="#" title="Add to WishList" class="product-wish-item" data-id="@product.ProductID">
                                                                    <span class="cart-text d-none d-xl-block "><i class="icon-heart white-color"></i> </span>
                                                                    <span class="d-block d-xl-none"><i class="icon-heart white-color "></i></span>
                                                                </a>
                                                            </li>
                                        @*<li>
                                            <a href="#" title="Quick View" data-toggle="modal" data-target="#quick_view_modal">
                                                <i class="icon-shuffle"></i>
                                            </a>
                                        </li>*@
                                    </ul>
                                </div>
                            </div>
                            <div class="product-info">
                                <h2 class="product-title"><a href="product-details.html">@product.ProductNameEnglish</a></h2>
                                <div class="product-price">
                                    <span>@product.PurchasingPrice</span>
                               
                                </div>
                            </div>
                        </div>
                    </div>

                }

            </div>

            </div>

        </div>

   }


   @section scripts{

       <script>
$(document).ready(function() {
    $(".product-wish-item").each(function() {

        let id = +$(this).attr("data-id");


        if (IsProductIn(id)) {
            $(this).addClass("active-color");

        }
        else {
            $(this).removeClass("active-color");
        }
    });


});
       </script>

   }


              
            
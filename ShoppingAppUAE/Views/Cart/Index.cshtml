<div class="liton__shoping-cart-area mb-100">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="shoping-cart-inner">
                    <div class="shoping-cart-table table-responsive">
                        <table class="table">
                       
                            <tbody id="cart-items-data">
                                
                               </tbody>
                        </table>
                    </div>
                    <div class="shoping-cart-total mt-50">
                        <h4>Cart Totals</h4>
                        <table class="table">
                            <tbody>
                                <tr>
                                    <td>Cart Subtotal</td>
                                    <td>$618.00</td>
                                </tr>
                                @*<tr>
                                    <td>Shipping and Handing</td>
                                    <td>$15.00</td>
                                </tr>
                                <tr>
                                    <td>Vat</td>
                                    <td>$00.00</td>
                                </tr>
                                <tr>
                                    <td><strong>Order Total</strong></td>
                                    <td><strong>$633.00</strong></td>
                                </tr>*@
                            </tbody>
                        </table>
                        <div class="btn-wrapper text-right">
                            <a href="checkout.html" class="theme-btn-1 btn btn-effect-1">Proceed to checkout</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{ 
    <script>
        $(document).ready(function () {
           
            buildCartRefresh();
        });

        function buildCartRefresh() {

            let currentCart = localStorage.getItem("cart");
            if (currentCart) {
                var cartArray = JSON.parse(currentCart);
                for (let item of cartArray) {
                    $("#cart-items-data").append(` <tr>
                                        <td class="cart-product-remove" data-id=${item.productId}>x</td>
                                        <td class="cart-product-image">
                                            <a href="product-details.html"><img src="/Images/${item.imageURL}" alt="#"></a>
                                        </td>
                                        <td class="cart-product-info">
                                            <h4><a href="product-details.html">${item.productName}t</a></h4>
                                        </td>
                                        <td class="cart-product-price">${item.price}</td>
                                        <td class="cart-product-quantity">
                                            <div class="cart-plus-minus">
                                                    <div class='dec qtybutton'> - </div>
                                                <input type="text" value="${item.Quantity}" name="qtybutton" class="cart-plus-minus-box">
                                              <div class='inc qtybutton'> + </div>
                                            </div>
                                        </td>
                                        <td class="cart-product-subtotal">${(item.price * item.Quantity)}</td>
                                    </tr>`);



                }
            }
        }
    </script>

}
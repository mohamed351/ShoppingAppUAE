@model IEnumerable<ShoppingAppUAE.Data.ShippingAndDelivery>
@section styles{ 
<style>
    .qtybutton{
        cursor:pointer;
    }
    .shipping-cart-item{
        list-style:none;
        display:flex;
        align-items:center;
        justify-content:space-between;
        padding-left:0px;

    }
    .card-shipping{
        border:1px solid #eee;
        padding:10px;
    }
</style>

}

<div class="ltn__breadcrumb-area ltn__breadcrumb-area-4 ltn__breadcrumb-color-white---">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ltn__breadcrumb-inner text-center">
                    <h1 class="ltn__page-title">Cart</h1>
                    <div class="ltn__breadcrumb-list">
                        <ul>
                            <li><a asp-action="Index" asp-controller="Home" asp-area="">Home</a></li>
                            <li>Cart</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




<div class="liton__shoping-cart-area mb-100">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <h2>Shipping</h2>
                @foreach (var item in Model)
                {
                    <ul>
                        <li class="shipping-cart-item card-shipping">
                            <input type="radio" class="shipping-cart-item-radio "
                                   name="shippingPirce" data-id="@item.ID"
                                   data-price="@item.ShippingPrice"
                                   data-weight-limit="@item.FirstWeightLimit"
                                   data-price-afterExisting="@item.PriceAfterExcedingTheLimit"
                                   data-weight-afterExisting ="@item.AdditionalKgAfterExcedingTheLimit"
                                   data-isDefault="@item.IsDefault" />  <span>@item.ShippingCompany</span>
                            </li>
                    </ul>
                }

            </div>


            <div class="col-lg-8">
                <h2>Cart</h2>
                <div class="shoping-cart-inner">
                    <div class="shoping-cart-table table-responsive">
                        <table class="table">

                            <tbody id="cart-items-data">
                            </tbody>
                        </table>
                    </div>
                    <div class="shoping-cart-total mt-50">
                        <h4>Cart Totals</h4>
                        <table class="table">
                            <tbody>
                                <tr>
                                    <td>Cart Subtotal</td>
                                    <td id="subTotalPriceInCart"></td>
                                </tr>

                                <tr>
                                    <td>Shipping and Handing</td>
                                    <td id="shippingPirce">0 LE</td>
                                </tr>
                                @*
        <tr>
            <td>Vat</td>
            <td>$00.00</td>
        </tr>
        <tr>
            <td><strong>Order Total</strong></td>
            <td><strong>$633.00</strong></td>
        </tr>*@
                            </tbody>
                        </table>
                        <div class="btn-wrapper text-right">
                            <a class="theme-btn-1 btn btn-effect-1">Proceed to checkout</a>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>

@section scripts{ 
    <script>
        $(document).ready(function () {
           
            buildCartRefresh();
           

            $("#cart-items-data").on("click", ".dec", function () {
                let productId = $(this).attr("product-id");
              
                decreseQuantity(productId);
                $("#cart-items-data").html("");
                buildCartRefresh();
                //build sidebar cart
                buildCart(localStorage.getItem("cart"));

            });


            $("#cart-items-data").on("click", ".inc", function () {

                let productId = $(this).attr("product-id");
                IncreseQuantity(productId);
                $("#cart-items-data").html("");
                buildCartRefresh();


            });

            
            $("#cart-items-data").on("click", ".cart-product-remove", function () {

                let productId = $(this).attr("data-id");
                deleteItem(productId);
                $("#cart-items-data").html("");
                buildCartRefresh();
               


            });
        });

        

        function buildCartRefresh() {

            let currentCart = localStorage.getItem("cart");
            if (currentCart) {
                var cartArray = JSON.parse(currentCart);
                for (let item of cartArray) {
                    $("#cart-items-data").append(` <tr>
                                        <td class="cart-product-remove" data-id=${item.productId}>x</td>
                                        <td class="cart-product-image">
                                            <a href="product-details.html"><img src="/Images/${item.imageURL}" alt="${item.productName}"></a>
                                        </td>
                                        <td class="cart-product-info">
                                            <h4><a href="/Product/CurrentProduct/${item.productId}">${item.productName}t</a></h4>
                                        </td>
                                        <td class="cart-product-price">${item.price} ${$("#GlobalCurrencyCode").val()}</td>
                                        <td class="cart-product-quantity">
                                            <div class="cart-plus-minus">
                                                    <div class='dec qtybutton' product-id="${item.productId}"> - </div>
                                                <input type="text" readonly value="${item.Quantity}" name="qtybutton" class="cart-plus-minus-box">
                                              <div class='inc qtybutton' product-id="${item.productId}"> + </div>
                                            </div>
                                        </td>
                                        <td class="cart-product-subtotal">${(item.price * item.Quantity) + $("#GlobalCurrencyCode").val()}</td>
                                    </tr>`);



                }
                $("#subTotalPriceInCart").text(calculateTotal() + $("#GlobalCurrencyCode").val());

            }
        }

        function decreseQuantity(productId) {
            let currentArray = JSON.parse(localStorage.getItem("cart"));
            if (currentArray) {
                let obj = currentArray.find(a => a.productId == productId)
                if (obj != null) {
                    obj.Quantity--;
                    if (obj.Quantity === 0) {
                        deleteItem(productId);
                        return;
                    }
                    localStorage.setItem("cart", JSON.stringify(currentArray));
                 
                }
            }
        }

        function IncreseQuantity(productId) {
            let currentArray = JSON.parse(localStorage.getItem("cart"));
            if (currentArray) {
                let obj = currentArray.find(a => a.productId == productId)
                if (obj != null) {
                    obj.Quantity++;
                    localStorage.setItem("cart", JSON.stringify(currentArray));
                  
                }
            }
        }
        function deleteItem(productId) {
           
            let currentArray = JSON.parse(localStorage.getItem("cart"));
            let newArray = currentArray.filter(a => a.productId !== productId);
        
            localStorage.setItem("cart", JSON.stringify(newArray));
           
        }

        function calculateTotal() {
            let currentArray = JSON.parse(localStorage.getItem("cart"));
            let sumSubTotals = 0;
            for (let item of currentArray) {
                sumSubTotals += (item.Quantity * item.price)
            }
            return sumSubTotals;
        }
        $(".shipping-cart-item-radio").on("change", function () {
       
            let totalWeight = calculateTotalWeight();
            const firstCostLimitInWeight = +$(this).attr("data-price");
            const firstWeightCost = $(this).attr("data-weight-limit");
            const eachKg = +$(this).attr("data-weight-afterExisting");
            const eachPrice = +$(this).attr("data-price-afterExisting");
         
            if (totalWeight > firstWeightCost) {
                const remaingKgs = totalWeight - firstWeightCost;
                console.log(remaingKgs);
                $("#shippingPirce").text(IncreseTheWeigthPrice(remaingKgs, eachKg, eachPrice, firstCostLimitInWeight) + $("#GlobalCurrencyCode").val());
            }
            else {
                $("#shippingPirce").text(firstCostLimitInWeight + $("#GlobalCurrencyCode").val());
            }
          
        });

        function CalculateShipping() {

        }

        function calculateTotalWeight() {
            let currentArray = JSON.parse(localStorage.getItem("cart"));
            let totalWeight = 0;
            for (let item of currentArray) {
                totalWeight += (item.weight * item.Quantity);
            }
            return totalWeight;
        }

        function IncreseTheWeigthPrice(remaning, each, priceAfter, totalPrice) {
            console.log("Remaning", remaning);
            console.log("EachKg", each);
            console.log("EachPrice", priceAfter);
            console.log("TotalPrice", totalPrice);
            return ((remaning / each) * priceAfter) + totalPrice;
        }
    </script>

}
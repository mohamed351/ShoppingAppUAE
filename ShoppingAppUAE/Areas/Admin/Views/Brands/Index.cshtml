@model IEnumerable<ShoppingAppUAE.Data.Brand>

@{
    ViewData["Title"] = "Index";
}


<div class="card">

    <div class="card-body">
        <div class="justify-content-between d-flex mb-3 align-items-center">
            <h3>Brands</h3>
      
                <a class="btn btn-success" asp-action="Create">Create New</a>
            
        </div>



        <table class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.BrandNameEnglish)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.BrandNameArabic)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ImageURL)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ImageAlternativeText)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.BrandNameEnglish)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.BrandNameArabic)
                        </td>
                        <td>
                            <img src="~/images/@item.ImageURL" style="width:50px;height:50px">
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ImageAlternativeText)
                        </td>
                        <td>
                            <a asp-action="Edit" class="btn btn-primary" asp-route-id="@item.ID">Edit</a> |
                            <a asp-action="Details" class="btn btn-warning" asp-route-id="@item.ID">Details</a> |
                            <a asp-action="Delete" class="btn btn-danger" asp-route-id="@item.ID">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@model ShoppingAppUAE.Areas.Admin.Models.BloggerViewModel.BlogCreateViewModel
@{
    ViewData["Title"] = "Create";
}
@section styles{

    <link href="~/js/jquery-ui/jqueryui/jquery-ui.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
      <link href="~/js/custome-cropper/cropper.min.css" rel="stylesheet" />
}


<form method="post" asp-controller="Blogger" asp-action="Create" >
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between">
                <h2>Create</h2> 
                <button type="submit" class="btn btn-success">Add</button>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Title</label>
                        <input type="text" class="form-control" asp-for="EnglishTitle" />
                    </div>

                    <div class="form-group">
                        <label>Arabic Title</label>
                        <input type="text" class="form-control" asp-for="ArabicTitle" />
                    </div>

                    <div>
                        <label>Photo</label>
                        <br />
                        <input type="file" id="file" />
                        <img id="image-src" style="width:50px;height:50px">
                        <input type="hidden" asp-for="ImageURL" />
                        <br />
                        <br />
                    </div>

                </div>


            </div>

            <div id="tabs">
                <ul>
                    <li><a href="#englishtab">English</a></li>
                    <li><a href="#arabictab">Arabic</a></li>

                </ul>

                <div id="englishtab">
                    <textarea asp-for="EnglishContent"></textarea>
                </div>


                <div id="arabictab">
                    <textarea asp-for="ArabicContent"></textarea>
                </div>


            </div>


        </div>
    </div>
</form>


<div class="modal fade" id="modal-default" tabindex="-1" role="dialog" aria-labelledby="modal-default" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-default-title">Crop Image</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="img-container">
                            <img src="" class="img-fluid" id="image-modal-cropper">

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="crop">Crop</button>
            </div>
        </div>

    </div>

</div>
@section scripts{


    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/jquery-ui/jqueryui/jquery-ui.js"></script>
    <script src="~/lib/tinymce/tinymce.min.js"></script>
    <script src="~/lib/tinymce/jquery.tinymce.min.js"></script>
    <script src="~/lib/select2/js/select2.full.min.js"></script>
    <script src="~/js/custome-cropper/cropper.min.js"></script>
    <script src="~/js/custome-cropper/jquery-cropper.min.js"></script>
    <script src="~/js/custome-cropper/custome-cropper.js"></script>
    <script src="~/lib/sweetalert/sweetalert.min.js"></script>

    <script>

         $("form").on("submit", function () {
                $("#ImageURL").val($("#image-src").attr("src"));
                if ($("#ImageURL").val() === null || $("#ImageURL").val() === undefined || $("#ImageURL").val().trim() === "") {
                    swal("Please Add Photo", "", "error");
                    return false;
                }


              
     
            });
     
        $(document).ready(function () {



            customimageCropper({
                fileSelector: "#file",
                modelImageSelector: "#image-modal-cropper",
                sourceImageSelector: "#image-src",
                submitSelector: "#crop",
                aspectRatio: 1 / 1,
                minContainerWidth: 500,
                minContainerHeight: 500,
                maxCropBoxWidth: 250,
                maxCropBoxHeight: 250
            });
            $("#tabs").tabs();
            tinymce.init({
                selector: '#EnglishContent',
                plugins: 'print preview  casechange importcss  searchreplace autolink autosave save directionality  visualblocks visualchars fullscreen image link   template codesample table charmap hr pagebreak nonbreaking anchor toc insertdatetime advlist lists  wordcount   imagetools textpattern noneditable help  permanentpen  charmap   quickbars  emoticons  ',
                menubar: 'file edit view insert format tools table tc help',
                toolbar: 'undo redo | bold italic underline strikethrough | fontselect fontsizeselect formatselect | alignleft aligncenter alignright alignjustify | outdent indent |  numlist bullist  | forecolor backcolor casechange permanentpen  removeformat | pagebreak | charmap emoticons | fullscreen  preview save print | insertfile image media pageembed template link anchor codesample | a11ycheck ltr rtl | showcomments addcomment',
                image_advtab: true
            });

            tinymce.init({
                selector: '#ArabicContent',
                plugins: 'print preview  casechange importcss  searchreplace autolink autosave save directionality  visualblocks visualchars fullscreen image link   template codesample table charmap hr pagebreak nonbreaking anchor toc insertdatetime advlist lists  wordcount   imagetools textpattern noneditable help  permanentpen  charmap   quickbars  emoticons  ',
                menubar: 'file edit view insert format tools table tc help',
                toolbar: 'undo redo | bold italic underline strikethrough | fontselect fontsizeselect formatselect | alignleft aligncenter alignright alignjustify | outdent indent |  numlist bullist  | forecolor backcolor casechange permanentpen  removeformat | pagebreak | charmap emoticons | fullscreen  preview save print | insertfile image media pageembed template link anchor codesample | a11ycheck ltr rtl | showcomments addcomment',
                image_advtab: true
            });

        });
    </script>
}


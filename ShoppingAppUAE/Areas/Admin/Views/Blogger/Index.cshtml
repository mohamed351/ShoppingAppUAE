
@{
    ViewData["Title"] = "Index";
}


@section styles{


    <link href="~/template/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.css" rel="stylesheet" />
}


<div class="card">
        <div class="card-body">
                <div class="d-flex" style="justify-content:space-between;align-items:center">
                    <h2>Blog</h2>
                   <a class="btn btn-success" asp-action="Create" asp-area="Admin" asp-controller="Blogger" >Create New Blogger </a>
                   
                </div>
        </div>

        <div>
            <table id="table-blogger" class="table" style="width:100%">
                <thead>
                   <tr>
                       <th>Title Arabic </th>
                       <th>Title English</th>
                       <th></th>
                   </tr>
                </thead>
                <tbody>

                </tbody>
            </table>
        </div>
</div>
@section scripts{
    <script src="~/template/assets/libs/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/template/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.js"></script>
    <script src="~/js/alphaDataTable.js"></script>
    <script>
        
tablePlugin("#table-blogger", "/Admin/Blogger/GetData", [{ data: "title" }, { data: "arabicTitle" }, { data: "id", render: function(data) { 

    return `<a href='/Admin/Blogger/Edit/${data}' class='btn btn-primary'> Edit</a> | <a class='btn btn-danger' href='/Admin/Blogger/Delete/${data}'>Delete </a>`
    
} }])
    </script>



}

@section styles{


    <link href="~/template/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.css" rel="stylesheet" />
}
<div class="card">
    <div class="card-body mb-5">
        <div class="d-flex justify-content-between align-center">
            <h5 class="card-title">Categories</h5>
            <a asp-action="Create" class="btn btn-success" asp-controller="Categories">Create</a>
        </div>
         <div class="mt-2">

         </div>



        <table class="table" width="100%" id="categoryTable">
            <thead>
                <tr>
                    <th>Arabic Name</th>
                    <th>English Name</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
            </tbody>
        </table>
    </div>
</div>
@section scripts{

    <script src="~/template/assets/libs/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/template/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.js"></script>

    <script src="~/js/alphaDataTable.js"></script>

    <script>

        $(document).ready(function () {
            tablePlugin("#categoryTable", "/Admin/Categories/GetCategories", [
                { data: "categoryNameArabic" },
                { data: "categoryNameEnglish" },
                {
                    data: "categoryID", render: function (data) {
                        return `<a class="btn btn-primary" href="/Admin/Categories/Edit/${data}"> Edit </a> |
                            <a class="btn btn-warning" href="/Admin/Categories/Details/${data}"> Details </a> |
                           <a class="btn btn-danger" href="/Admin/Categories/Delete/${data}"> Delete </a>`
                    }
                }

            ])

        });
    </script>
}


@{
    ViewData["Title"] = "Index";
}

@section styles{


    <link href="~/template/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.css" rel="stylesheet" />
}
<div class="card">

    <div class="card-body">

        <div class="d-flex justify-content-between">

        </div>

        <table id="orderTable" class="table" width="100%">

            <thead>
                <tr>
                    <th>
                        User
                    </th>
                    <th>
                        User Country
                    </th>
                    <th>
                        City
                    </th>
                    <th>
                       Original Phone
                    </th>
                    <th>
                        Order Phone
                    </th>
                    <th>
                        Order Type
                    </th>
                    <th>
                        DateTimeIssued
                    </th>
                    <th>
                        Exchange Rate
                    </th>

                    <th>
                       Currency Code
                    </th>
                    <th>
                        Shipping Provider
                    </th>

                    <th>
                        Shipping Fess
                    </th>
                  <th>
                      Total
                  </th>

                    <th>

                    </th>

                 

                </tr>
            </thead>

        </table>

    </div>
</div>

@section scripts{

    <script src="~/template/assets/libs/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/template/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.js"></script>
    <script  src="~/lib/sweetalert/sweetalert.min.js"></script>
    <script src="~/js/alphaDataTable.js"></script>

    <script>

        $(document).ready(function () {
          globalTable =   tablePlugin("#orderTable", "/Admin/Orders/GetOrders", [
                { data: "user" },
                { data: "countryCode" },
                { data: "city" },
                { data: "userPhone" },
                { data: "orderPhone" },
                {
                    data: "orderType", render: function(result) {
                        if (result == 0) {
                            return `<span class="badge rounded-pill bg-primary" style='color:#fff'> On Delivery</span>`
                        }
                        else {
                            return `<span class="badge rounded-pill bg-info" style='color:#fff'> Card</span>`
                        }

                    }
                },
                { data: "dateTimeIssued" },
                { data: "exchangeRate" },
                { data: "currencyCode" },
                { data: "shippingProvider" },
                { data: "shippingFees" },
                { data: "total" },
                {
                    data: "orderID", render: function(result,row, data) {
                        console.log(data);
                        return `<div class='d-flex'> 
                            <a class='btn btn-warning'> Details </a>
                           ${(!data.approved && !data.cancelled)   ? `<button class='btn btn-primary approve-button' data-id=${result}> Approve </button>` : '' }
                            ${ (!data.approved && !data.cancelled)  ? `<a class='btn btn-danger'> Cancel </a>` : '' }
                            <a class='btn btn-info' href='/Admin/Orders/InvoicePDF/${result}' target='_blank'> View In Print </a>
                        </div>`;
                    }
                }




            ]);
            $(document).on("click", ".approve-button", function() {

                $.ajax({
                    url:"/Admin/Orders/ApproveInvoice",
                    method:"POST",
                    contentType:"application/json",
                    type:"json",
                    data:  JSON.stringify(+$(this).attr("data-id")),
                    success: function(result) {
                        swal(result.message, "", (result.status ? "success" : "error"));
                        globalTable.ajax.reload();
                        
                    }
                });


            });

        });
    </script>
}



@{
    ViewData["Title"] = "Index";
}

@section styles{


    <link href="~/template/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.css" rel="stylesheet" />
}
<div class="card">

    <div class="card-body">

        <div class="d-flex justify-content-between">

        </div>

        <table id="orderTable" class="table" width="100%">

            <thead>
                <tr>
                    <th>
                        User
                    </th>
                    <th>
                        User Country
                    </th>
                    <th>
                        City
                    </th>
                    <th>
                       Original Phone
                    </th>
                    <th>
                        Order Phone
                    </th>
                    <th>
                        Order Type
                    </th>
                    <th>
                        DateTimeIssued
                    </th>
                    <th>
                        Exchange Rate
                    </th>

                    <th>
                       Currency Code
                    </th>
                    <th>
                        Shipping Provider
                    </th>

                    <th>
                        Shipping Fess
                    </th>
                  <th>
                      Total
                  </th>

                    <th>

                    </th>

                 

                </tr>
            </thead>

        </table>

    </div>
</div>

@section scripts{

    <script src="~/template/assets/libs/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/template/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.js"></script>

    <script src="~/js/alphaDataTable.js"></script>

    <script>

        $(document).ready(function () {
            tablePlugin("#orderTable", "/Admin/Orders/GetOrders", [
                { data: "user" },
                { data: "countryCode" },
                { data: "city" },
                { data: "userPhone" },
                { data: "orderPhone" },
                { data: "orderType" },
                { data: "dateTimeIssued" },
                { data: "exchangeRate" },
                { data: "currencyCode" },
                { data: "shippingProvider" },
                { data: "shippingFees" },
                { data: "total" },
                {
                    data: "orderID", render: function (result) {
                        return result;
                    }
                }

             
               

            ])

        });
    </script>
}


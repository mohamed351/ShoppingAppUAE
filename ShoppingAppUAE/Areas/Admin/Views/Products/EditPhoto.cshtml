@model ShoppingAppUAE.Data.Product
@{
    ViewData["Title"] = "EditPhoto";
}


@section styles{
    <link href="~/js/custome-cropper/cropper.min.css" rel="stylesheet" />
}

<input  type="hidden" asp-for="ProductID" />
<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center card-header">
            <h2>Edit Photo</h2>
            <div>
                <input type="file" id="file" />
                <img style="display:none" id="image-src" />
            </div>
        </div>
        
            <table class="table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th></th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ProductImages)
                    {
                        <tr class="d-flex align-items-center justify-content-between">
                            <td> <img src="~/images/@item.ImagesURL" style="width:100px;height:100px;" /> </td>
                            <td> <button class="btn btn-success"> Add</button> | <button class="btn btn-primary">Edit </button></td>
                        </tr>

                    }
                </tbody>

            </table>
        
    </div>
</div>

<div class="modal fade" id="modal-default" tabindex="-1" role="dialog" aria-labelledby="modal-default" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-default-title">Crop Image</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="img-container">
                            <img src="" class="img-fluid" id="image-modal-cropper">

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="crop">Crop</button>
            </div>
        </div>

    </div>

</div>


@section scripts{
    <script src="~/lib/select2/js/select2.full.min.js"></script>
    <script src="~/js/custome-cropper/cropper.min.js"></script>
    <script src="~/js/custome-cropper/jquery-cropper.min.js"></script>
    <script src="~/js/custome-cropper/custome-cropper.js"></script>
    <script src="~/lib/sweetalert/sweetalert.min.js"></script>
    <script>


        $(document).ready(function () {

            customimageCropper({
                fileSelector: "#file",
                modelImageSelector: "#image-modal-cropper",
                sourceImageSelector: "#image-src",
                submitSelector: "#crop",
                aspectRatio: 1 / 1,
                minContainerWidth: 400,
                minContainerHeight: 400,
                maxCropBoxWidth: 400,
                maxCropBoxHeight: 400
            });
          
        });

        $('#image-src').on('load', function () {
           let source = $(this).attr("src");
            $.ajax({
                url: "/Admin/Products/EditPhoto",
                contentType: "application/json",
                type: "json",
                method: "POST",
                data: JSON.stringify( { base64: source, productId: $("#ProductID").val()}),
                success: function (result) {
                    window.location.href = window.location.href;
                }
            });
         
        });
    </script>

}
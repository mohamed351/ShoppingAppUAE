@model ShoppingAppUAE.Areas.Admin.Models.ProductsViewModel.ProductEditViewModel
@{
    ViewData["Title"] = "Create";
}

@section styles{

    <link href="~/lib/image-cropper/css/jquery.Jcrop.css" rel="stylesheet" />
    <link href="~/lib/image-cropper/css/style.css" rel="stylesheet" />
    <link href="~/lib/image-cropper/css/style-example.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
    <link href="~/js/custome-cropper/cropper.min.css" rel="stylesheet" />
}
<form asp-action="Edit" method="post">
    <div class="card">
        <div class="card-body">
            <div class="d-flex mb-2 justify-content-end">
                <button type="submit" class="btn btn-success">Edit Product</button>
            </div>
            <input type="hidden" asp-for="ProductID" />
            <div class="row">


                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="ProductNameEnglish"></label>
                        <input type="text" class="form-control" asp-for="ProductNameEnglish" />
                    </div>

                    <div class="form-group">
                        <label asp-for="ProductNameArabic"></label>
                        <input type="text" class="form-control" asp-for="ProductNameArabic" />
                    </div>


                    <div class="form-group">
                        <label asp-for="PurchasingPrice"></label>
                        <input type="number" step="any" class="form-control" asp-for="PurchasingPrice" />
                    </div>

                    <div class="form-group">
                        <label asp-for="SellingPrice"></label>
                        <input type="number" step="any" class="form-control" asp-for="SellingPrice" />
                    </div>

                    <div class="form-group">
                        <label asp-for="Weight"></label>
                        <input type="number" step="any" class="form-control" asp-for="Weight" />
                    </div>


                    <div class="form-group">
                        <label asp-for="CategoryID"></label>
                        <select asp-for="CategoryID" class="form-control" asp-items="ViewBag.Categories"></select>




                    </div>

                    <div class="form-group">
                        <label asp-for="BreifDescriptionArabic"></label>
                        <textarea class="form-control" asp-for="BreifDescriptionArabic"></textarea>
                    </div>
                    <div class="form-group">
                        <label asp-for="BreifDescriptionEnglish"></label>
                        <textarea class="form-control" asp-for="BreifDescriptionEnglish"></textarea>
                    </div>


                    <div class="form-group">
                        <label asp-for="VideoIFrameURL"></label>
                        <input type="text" class="form-control" asp-for="VideoIFrameURL" />
                    </div>

                    <div class="form-group">
                        <label asp-for="BrandID"></label>
                        <select asp-for="BrandID" class="form-control" asp-items=" ViewBag.Brand"></select>




                    </div>

                    <div>
                        <label asp-for="IsArravel"></label>
                        <input type="checkbox" asp-for="IsArravel" />
                    </div>

                    <div>
                        <label asp-for="IsTop10"></label>
                        <input type="checkbox" asp-for="IsTop10" />
                    </div>

                    <div class="form-group">
                        <label asp-for="Discount"></label>
                        <input type="number" step="any" class="form-control" asp-for="Discount" />
                    </div>

                    <div class="form-group">
                        <label asp-for="ImageAlternativeText"></label>
                        <input class="form-control" asp-for="ImageAlternativeText" />
                    </div>



                    <div class="form-group">
                        <label asp-for="SEOEnglishTitle"></label>
                        <input type="text" class="form-control" asp-for="SEOEnglishTitle" />
                    </div>

                    <div class="form-group">
                        <label asp-for="SEOArabicTitle"></label>
                        <input type="text" class="form-control" asp-for="SEOArabicTitle" />
                    </div>




                    <div class="form-group">
                        <label asp-for="SEOArabicKeyWords"></label>
                        <select class="form-control" type="text" id="SEOArabicKeyWordsselect"></select>
                        <input type="hidden" asp-for="SEOArabicKeyWords" />
                    </div>


                    <div class="form-group">
                        <label asp-for="SEOEnglishKeyWords"></label>
                        <select class="form-control" type="text" id="SEOEnglishKeyWordsselect"></select>
                        <input type="hidden" asp-for="SEOEnglishKeyWords" />
                    </div>






                </div>



                <div class="col-md-6">

                    <div style="width:400px; height:400px;">
                        <img src="~/images/@Model.ImageURL" style="width: 400px; width: 400px; ">
                    </div>
                    <div style="width:400px; height:400px;">
                        <img id="image-src" style="width: 400px; width: 400px; ">
                    </div>

                    <input type="file" id="file" />
                    <input type="hidden" />
                    <input type="hidden" id="ImageURL" name="ImageURL" />
                    @*<div style="width:400px; height:400px;" style="display: flex; justify-content: center;">

                            <div class="span4 cropme" style="width:400px; height:400px;"></div>
                        </div>*@
                </div>



                <div class="col-md-12">

                    <div class="form-group">
                        <label asp-for="DescriptionEnglish"></label>
                        <input type="text" asp-for="DescriptionEnglish" />
                    </div>

                    <div class="form-group">
                        <label asp-for="DescriptionArabic"></label>

                        <input asp-for="DescriptionArabic" />
                    </div>





                </div>

            </div>



        </div>


    </div>

</form>

<div class="modal fade" id="modal-default" tabindex="-1" role="dialog" aria-labelledby="modal-default" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-default-title">Crop Image</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="img-container">
                            <img src="" class="img-fluid" id="image-modal-cropper">

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="crop">Crop</button>
            </div>
        </div>

    </div>

</div>


@section Scripts {
    <script src="~/lib/image-cropper/scripts/jquery.Jcrop.js"></script>
    <script src="~/lib/image-cropper/scripts/jquery.SimpleCropper.js"></script>
    <script src="~/lib/tinymce/tinymce.min.js"></script>
    <script src="~/lib/tinymce/jquery.tinymce.min.js"></script>
    <script src="~/lib/select2/js/select2.full.min.js"></script>
    <script src="~/js/custome-cropper/cropper.min.js"></script>
    <script src="~/js/custome-cropper/jquery-cropper.min.js"></script>
    <script src="~/js/custome-cropper/custome-cropper.js"></script>
    <script src="~/lib/sweetalert/sweetalert.min.js"></script>
    <script>
        $(document).ready(function () {

            customimageCropper({
                fileSelector: "#file",
                modelImageSelector: "#image-modal-cropper",
                sourceImageSelector: "#image-src",
                submitSelector: "#crop",
                aspectRatio: 1 / 1,
                minContainerWidth: 500,
                minContainerHeight: 500,
                maxCropBoxWidth: 250,
                maxCropBoxHeight: 250
            });
        });

        $("form").on("submit", () => {
            $("#ImageURL").val($("#image-src").attr("src"));
            $("#SEOArabicKeyWords").val($("#SEOArabicKeyWordsselect").val().join(","));
            $("#SEOEnglishKeyWords").val($("#SEOEnglishKeyWordsselect").val().join(","));

        });
        tinymce.init({
            selector: '#DescriptionEnglish',
            plugins: 'table',
            menubar: 'table'
        });

        tinymce.init({
            selector: '#DescriptionArabic',
            plugins: 'table',
            menubar: 'table'
        });


        $("#SEOArabicKeyWordsselect").select2({
            tags: true,
            multiple: true,
            width: 'resolve',
            tokenSeparators: [',', ' '],
        });
        $("#SEOEnglishKeyWordsselect").select2({
            tags: true,
            multiple: true,
            width: 'resolve',
            tokenSeparators: [',', ' ']
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


@{
    ViewData["Title"] = "Index";
}

@section styles{

    <link href="~/template/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.css" rel="stylesheet" />
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
            <h2>Users</h2>
            <a class="btn btn-success" asp-action="Create" asp-controller="User" asp-area="Admin"> Create User</a>
        </div>

        <div>
            <table id="UsersTable" width="100%" class="table">
                <thead>
                    <tr>
                        <th>FirstName</th>
                        <th>Last Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section scripts{


    <script src="~/template/assets/libs/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/template/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.js"></script>

    <script src="~/js/alphaDataTable.js"></script>

    <script>

        $(document).ready(function () {
            tablePlugin("#UsersTable", "/Admin/User/GetUsers", [
                { data: "firstName" },
                { data: "lastName" },
                { data: "email" },
                { data:"phoneNumber"},
                {
                    data: "id", render: function (data) {
                        return `<div class='d-flex justify-content-center'>
                                <a class='btn btn-warning' href='/Admin/User/Details/${data}'> Details </a>
                            <button class='btn btn-danger' data-id=${data}> Lock User </button> </div>`
                    }
                }

            ])

        });
    </script>

}


@model ShoppingAppUAE.Data.ContactMessage
@{
    ViewData["Title"] = "Details";
}

<div class="card">
   
    <div class="card-body">

        <div >
            <h3>Contact Message from @Model.Name</h3>
        </div>
        <table class="table">


            <tr>
                <th>Title</th>
                <td>@Model.Title</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>@Model.Name</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>@Model.Email</td>
            </tr>

            <tr>

                <th>Phone</th>
                <td>@Model.PhoneNumber</td>
            </tr>
            <tr>


                <th>Message</th>
                <td>@Model.Message</td>
            </tr>


        </table>
    </div>
</div>

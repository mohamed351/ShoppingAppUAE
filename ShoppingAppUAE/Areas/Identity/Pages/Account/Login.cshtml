@page
@model LoginModel
@inject IViewLocalizer locaization

@{
    ViewData["Title"] = "Log in";
}



<div class="ltn__login-area pb-85" style="padding-top:44px">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title-area text-center">
                    <h1>  @locaization["Login"] </h1>

                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-6">
                <div class="account-login-inner">
                    <form id="account" method="post" class="ltn__form-box contact-form-box">
                        <div class="form-group">
                            <label asp-for="Input.UserName">@locaization["UserName"] </label>
                            <input asp-for="Input.UserName" class="form-control" />
                            <span asp-validation-for="Input.UserName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.Password">@locaization["Password"]</label>
                            <input asp-for="Input.Password" class="form-control" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <div class="checkbox">
                                <label asp-for="Input.RememberMe">
                                    <input asp-for="Input.RememberMe" />
                                    @locaization["RememberMe"]
                                </label>
                            </div>
                        </div>
                        <div class="btn-wrapper mt-0">
                            <button class="theme-btn-1 btn btn-block" type="submit">@locaization["Sign In"]</button>
                        </div>
                        <div class="go-to-btn mt-20">
                            <a asp-action="ForgotPassword" asp-controller="Account" asp-area="Identity"><small>@locaization["ForgetPassword"]</small></a>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="account-create text-center pt-50">
                    <h4>@locaization["DoNotHaveAccount"]</h4>
                    <p>
                       @locaization["ParagraphAccount"]
                    </p>
                    <div class="btn-wrapper">
                        <a asp-action="Register" asp-controller="Account" asp-area="Identity" class="theme-btn-1 btn black-btn">@locaization["CreateAccount"]</a>
                    </div>
                </div>

                <div class="account-create text-center pt-50">
                    <section>
                        <h4>@locaization["Use another service to log in."]</h4>
                        <hr />
                        @{
                            if ((Model.ExternalLogins?.Count ?? 0) == 0)
                            {

                            }
                            else
                            {
                                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                                    <div>
                                        <p>
                                            @foreach (var provider in Model.ExternalLogins)
                                            {
                                                <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                                            }
                                        </p>
                                    </div>
                                </form>
                            }
                        }
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>






@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

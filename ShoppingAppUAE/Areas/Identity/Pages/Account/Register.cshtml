@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

@section styles{
    <style>
        .nice-select {
            width: 100% !important;
            padding: 0 !important;
            padding-left: 10px !important;
        }
    </style>
    <link href="~/lib/select2/css/select2.css" rel="stylesheet" />

}



<div class="ltn__login-area pb-90">
    <div class="container">


        <div class="row">
            <div class="col-lg-12">
                <div class="section-title-area text-center">
                    <h1>@ViewData["Title"]</h1>
                    <p>
                        Have a greate Day
                    </p>
                </div>
            </div>
        </div>


        <div class="row">
            <div class="col-lg-6 offset-lg-3">
                <div class="account-login-inner">
                    <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="form-group">
                            <label asp-for="Input.FirstName"></label>
                            <input asp-for="Input.FirstName" placeholder="First Name" class="form-control" />
                            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                        </div>



                        <div class="form-group">
                            <label asp-for="Input.LastName"></label>
                            <input asp-for="Input.LastName" placeholder="Last Name" class="form-control" />
                            <span asp-validation-for="Input.LastName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.Email"></label>
                            <input asp-for="Input.Email" placeholder="Email" class="form-control" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.Password"></label>
                            <input asp-for="Input.Password" placeholder="Password" class="form-control" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.ConfirmPassword"></label>
                            <input asp-for="Input.ConfirmPassword" placeholder="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.County" class="control-label"></label>
                            <div>
                                <select asp-for="Input.County" style="width:100% !important" class="form-control" asp-items="@((SelectList)ViewData["Country"])">
                                    <option disabled selected>Select country</option>
                                </select>
                                <span asp-validation-for="Input.County" class="text-danger"></span>
                            </div>
                        </div>
                        <br />

                        <div class="form-group">
                            <label asp-for="Input.City"></label>
                            <input placeholder="City" type="text" asp-for="Input.City" class="form-control" />
                            <span asp-validation-for="Input.City" class="text-danger"></span>
                        </div>


                        <div class="form-group">
                            <label asp-for="Input.Phone"></label>
                            <div>
                                <input type="text" class="form-control" id="PhonePrefix" asp-for="Input.PhonePrefix" style="width:14%;display:inline-block;padding:5px;" readonly />  <input placeholder="Phone" type="text" asp-for="Input.Phone" class="form-control" style="display:inline-block;width:82%" />
                            </div>
                            <span asp-validation-for="Input.Phone" class="text-danger"></span>
                        </div>


                        <div class="form-group">
                            <label asp-for="Input.Address"></label>
                            <input placeholder="Address" type="text" asp-for="Input.Address" class="form-control" />
                            <span asp-validation-for="Input.Address" class="text-danger"></span>
                        </div>


                        <label class="checkbox-inline">
                            <input type="checkbox" asp-for="Input.AcceptPolicy">
                            By clicking "create account", I consent to the privacy policy.
                        </label>
                        <div class="btn-wrapper">
                            <button class="theme-btn-1 btn reverse-color btn-block" type="submit">CREATE ACCOUNT</button>
                        </div>


                        <div class="by-agree text-center">
                            <p>By creating an account, you agree to our:</p>
                            <p><a href="#">TERMS OF CONDITIONS  &nbsp; &nbsp; | &nbsp; &nbsp;  PRIVACY POLICY</a></p>
                            <div class="go-to-btn mt-50">
                                <a asp-action="Login" asp-controller="Account" asp-area="Identity">ALREADY HAVE AN ACCOUNT ?</a>
                            </div>
                        </div>




                    </form>

                </div>
            </div>
        </div>
    </div>
</div>


<div class="account-create text-center pt-50">
    <section>
        <h4>Use another service to log in.</h4>
        <hr />
        @{
            if ((Model.ExternalLogins?.Count ?? 0) == 0)
            {

            }
            else
            {
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                    <div>
                        <p>
                            @foreach (var provider in Model.ExternalLogins)
                            {
                                <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                            }
                        </p>
                    </div>
                </form>
            }
        }
    </section>
</div>


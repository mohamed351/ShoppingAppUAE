@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/select2/js/select2.js"></script>
    <script>
        var currentCountries = [];
        $.ajax({
            url: "/api/Countries",
            method: "GET",
            success: function (result) {
                currentCountries = result;
            }
        })
        $("#Input_County").select2();

        $("#Input_County").on("change", function () {

            let countryCode = $(this).val();
            let selectedCountry = currentCountries.find(a => a.code === countryCode);
            console.log(selectedCountry.prefix);
            $("#PhonePrefix").val(selectedCountry.prefix);


        });


    </script>
}
